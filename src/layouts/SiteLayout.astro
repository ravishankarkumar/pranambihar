---
interface Props { title: string; description: string; eyebrow: string; heading: string; intro: string; compactHero?: boolean; }
const { title, description, eyebrow, heading, intro, compactHero = false } = Astro.props;
---
<!doctype html>
<html lang="en">
<head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><link rel="icon" href="/favicon.svg"/><title>{title} · Pranam Bihar</title></head>
<body>
  <header><a class="brand" href="/"><b>प</b><span><strong>PRANAM</strong><small>BIHAR</small></span></a><nav><a href="/foods/">Food</a><a href="/places/">Places</a><a href="/living-bihar/">Living Bihar</a><a href="/people/">People</a><a href="/stories/">Stories</a></nav><a class="home" href="/">Home ↗</a></header>
  <main><section class={`page-hero ${compactHero ? 'compact' : ''}`}><div class="wrap"><p class="kicker">{eyebrow}</p><h1>{heading}</h1><p class="intro">{intro}</p></div></section><slot /></main>
  <footer><div class="wrap"><a class="brand inverse" href="/"><b>प</b><span><strong>PRANAM</strong><small>BIHAR</small></span></a><p>Looking at Bihar with fresh eyes.<br/>Telling the stories that deserve to travel.</p><nav><a href="/foods/">Food</a><a href="/places/">Places</a><a href="/living-bihar/">Living Bihar</a><a href="/people/">People</a><a href="/stories/">Stories</a><a href="/about/">About</a><a href="/editorial-standards/">Standards</a></nav></div><div class="wrap copyright">© {new Date().getFullYear()} Pranam Bihar <span>Made with respect in Bihar</span></div></footer>
</body>
</html>
<style is:global>
  :root{--ink:#142c27;--cream:#f4eee2;--paper:#fbf8f1;--gold:#e9a93a;--red:#a9432e;--muted:#69706b;--line:rgba(20,44,39,.17)}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font:16px/1.6 Arial,sans-serif}a{color:inherit;text-decoration:none}.wrap{width:min(1120px,calc(100% - 48px));margin:auto}header{height:88px;padding:0 max(24px,4vw);display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);background:var(--paper)}.brand{display:flex;align-items:center;gap:11px;line-height:1}.brand b{width:40px;height:40px;border-radius:50%;display:grid;place-items:center;background:var(--ink);color:var(--cream);font:22px Georgia}.brand strong,.brand small{display:block;letter-spacing:.17em}.brand strong{font-size:13px}.brand small{font-size:9px;color:var(--red);margin-top:6px}header nav{display:flex;gap:24px;font-size:12px;font-weight:bold}header nav a:hover{color:var(--red)}.home{text-transform:uppercase;letter-spacing:.14em;font-size:10px;font-weight:bold}.page-hero{padding:115px 0 90px;background:var(--cream);position:relative;overflow:hidden}.page-hero:after{content:'प्र';position:absolute;right:5vw;top:-35px;color:rgba(169,67,46,.07);font:260px Georgia}.kicker,.tag{text-transform:uppercase;letter-spacing:.2em;color:var(--red);font-size:10px;font-weight:bold}.page-hero h1{max-width:850px;margin:18px 0 25px;font:clamp(58px,8vw,106px)/.95 Georgia;letter-spacing:-.05em}.intro{max-width:620px;font:21px/1.55 Georgia;color:var(--muted)}.collection{padding:95px 0 130px}.collection-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:45px}.collection h2{font:45px/1 Georgia;margin:0}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}.card{border-top:1px solid var(--ink);padding-top:18px}.card .number{display:block;color:var(--red);font-size:10px;letter-spacing:.14em;margin-bottom:50px}.card h2,.card h3{font:30px/1.15 Georgia;margin:10px 0 15px}.card p{color:var(--muted);font-size:14px}.card a{display:inline-block;margin-top:16px;border-bottom:1px solid;font-size:10px;text-transform:uppercase;letter-spacing:.14em;font-weight:bold}.feature-list{display:grid}.feature{display:grid;grid-template-columns:70px 1fr 1fr 30px;gap:28px;align-items:center;padding:32px 0;border-top:1px solid var(--line)}.feature:last-child{border-bottom:1px solid var(--line)}.feature small{color:var(--red)}.feature h2{font:35px Georgia;margin:0}.feature p{margin:0;color:var(--muted)}.prose{max-width:760px;margin:0 auto}.prose h2{font:45px Georgia;margin:60px 0 18px}.prose p{font:19px/1.8 Georgia;color:#45504c}.note{background:var(--ink);color:var(--cream);padding:80px;margin-top:80px}.note blockquote{font:38px/1.3 Georgia;margin:0;max-width:850px}footer{background:#0c1d19;color:rgba(255,255,255,.67);padding:65px 0 24px}footer>.wrap:first-child{display:grid;grid-template-columns:1fr 1fr 1fr;gap:35px}.inverse{color:white}.inverse b{background:var(--gold);color:var(--ink)}footer p{font:16px Georgia}footer nav{display:grid;grid-template-columns:1fr 1fr;gap:15px;font-size:11px;text-transform:uppercase;letter-spacing:.1em}.copyright{border-top:1px solid rgba(255,255,255,.12);margin-top:45px;padding-top:20px;display:flex;justify-content:space-between;font-size:10px;text-transform:uppercase;letter-spacing:.1em}
  .page-hero.compact{padding:68px 0 52px}.page-hero.compact h1{max-width:1000px;font-size:clamp(50px,6vw,78px)}.page-hero.compact .intro{max-width:760px;font-size:18px}
  @media(max-width:760px){header{height:auto;padding:18px 20px;align-items:flex-start}header nav{display:grid;grid-template-columns:1fr 1fr;gap:7px 18px}header .home{display:none}.brand span{display:none}.page-hero{padding:80px 0 65px}.page-hero h1{font-size:60px}.page-hero.compact{padding:58px 0 45px}.page-hero.compact h1{font-size:48px}.grid{grid-template-columns:1fr;gap:55px}.collection{padding:70px 0 90px}.feature{grid-template-columns:35px 1fr 20px}.feature p{grid-column:2}.feature h2{font-size:29px}footer>.wrap:first-child{grid-template-columns:1fr}.copyright{flex-direction:column;gap:12px}}
</style>
