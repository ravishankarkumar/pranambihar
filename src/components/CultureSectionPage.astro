---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
interface EntryGroupLabels { featuredEyebrow: string; featuredTitle: string; featuredIntro: string; otherEyebrow: string; otherTitle: string; otherIntro: string; }
interface Props { section: 'festivals'|'languages'|'art-craft'|'textiles'|'music-performance'|'traditions'|'living-memory'; title: string; eyebrow: string; heading: string; intro: string; note: string; entryGroupLabels?: EntryGroupLabels; entryOrder?: string[]; }
const { section, title, eyebrow, heading, intro, note, entryGroupLabels, entryOrder = [] } = Astro.props;
const orderRank = (id: string) => { const position = entryOrder.indexOf(id); return position === -1 ? Number.MAX_SAFE_INTEGER : position; };
const entries = (await getCollection('culture')).filter(entry => entry.data.section === section).sort((a,b) => Number(b.data.featured) - Number(a.data.featured) || orderRank(a.id) - orderRank(b.id) || a.data.title.localeCompare(b.data.title));
const entryGroups = entryGroupLabels
  ? [
      { eyebrow: entryGroupLabels.featuredEyebrow, title: entryGroupLabels.featuredTitle, intro: entryGroupLabels.featuredIntro, entries: entries.filter(entry => entry.data.featured), style: 'featured' },
      { eyebrow: entryGroupLabels.otherEyebrow, title: entryGroupLabels.otherTitle, intro: entryGroupLabels.otherIntro, entries: entries.filter(entry => !entry.data.featured), style: 'secondary' },
    ]
  : [{ eyebrow: '', title: '', intro: '', entries, style: 'standard' }];
---
<SiteLayout title={title} description={intro} eyebrow={eyebrow} heading={heading} intro={intro} compactHero={true}>
  <nav class="crumb wrap" aria-label="Breadcrumb"><a href="/culture/">Culture</a><span>→</span><b>{title}</b></nav>
  <slot name="overview" />
  <section class="section-index wrap"><div class="index-heading"><p class="tag">{entries.length} growing {entries.length === 1 ? 'entry' : 'entries'}</p><p>{note}</p></div>{entryGroups.map(group => <section class={`entry-group ${group.style}`}>{group.title && <header class="group-heading"><div><p class="tag">{group.eyebrow}</p><h2>{group.title}</h2></div><p>{group.intro}</p></header>}<div class={`entry-grid ${group.style}`}>{group.entries.map((entry,index) => <a class={`entry-card accent-${entry.data.accent}`} href={`/culture/${section}/${entry.id}/`}><div><span>{entry.data.localName || String(index+1).padStart(2,'0')}</span></div><small>{entry.data.kind} · {entry.data.season}</small><h2>{entry.data.title}</h2><p>{entry.data.summary}</p><footer><span>{entry.data.region}</span><i>Explore ↗</i></footer></a>)}</div></section>)}</section>
  <slot name="after-index" />
  <section class="people-note"><div class="wrap"><p class="tag">Culture has names and faces</p><h2>Meet the people who carry it.</h2><p>Individual artists, cooks, speakers, organisers and custodians belong in the People archive, connected to the traditions they sustain.</p><a href="/people/">Explore People →</a></div></section>
</SiteLayout>
<style>
  .crumb{display:flex;gap:12px;padding-top:18px;font-size:9px;text-transform:uppercase;letter-spacing:.1em;color:#69706b}.crumb a{border-bottom:1px solid}.crumb b{color:#142c27}.section-index{padding:38px 0 110px}.index-heading{display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:start;margin-bottom:45px}.index-heading>p:last-child{color:#69706b;margin:0}.entry-group+.entry-group{margin-top:80px;padding-top:45px;border-top:1px solid rgba(20,44,39,.16)}.group-heading{display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:end;margin-bottom:28px}.group-heading h2{font:40px/1.05 Georgia;margin:10px 0 0}.group-heading>p{font-size:14px;color:#69706b;margin:0}.entry-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.entry-grid.featured{grid-template-columns:repeat(6,1fr)}.entry-grid.featured .entry-card{grid-column:span 2}.entry-grid.featured .entry-card:nth-child(4),.entry-grid.featured .entry-card:nth-child(5){grid-column:span 3}.entry-grid.secondary{grid-template-columns:repeat(4,1fr)}.entry-card{border:1px solid rgba(20,44,39,.14);background:#fff;padding-bottom:24px}.entry-card>div{height:180px;display:grid;place-items:center;background:var(--culture-color);color:#fff;position:relative;overflow:hidden}.entry-card>div:before,.entry-card>div:after{content:'';position:absolute;border:1px solid currentColor;border-radius:50%;width:130px;height:130px;opacity:.27}.entry-card>div:after{width:80px;height:80px}.entry-card>div span{font:30px Georgia;z-index:1}.entry-card>small,.entry-card h2,.entry-card>p,.entry-card footer{display:block;margin-left:22px;margin-right:22px}.entry-card>small{font-size:7px;text-transform:uppercase;letter-spacing:.08em;color:#a9432e;margin-top:18px}.entry-card h2{font:28px/1.05 Georgia;margin-top:7px;margin-bottom:10px}.entry-card>p{font-size:12px;color:#69706b;min-height:76px}.entry-card footer{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:start;gap:20px;border-top:1px solid rgba(20,44,39,.13);padding:14px 0 0;background:transparent;color:#142c27;line-height:1.45}.entry-card footer span,.entry-card footer i{font-size:8px;text-transform:uppercase;letter-spacing:.07em}.entry-card footer span{overflow-wrap:anywhere}.entry-card footer i{font-style:normal;white-space:nowrap}.entry-grid.secondary .entry-card>div{height:125px}.entry-grid.secondary .entry-card h2{font-size:23px}.entry-grid.secondary .entry-card>p{font-size:11px;min-height:92px}.entry-grid.secondary .entry-card footer{display:grid}.entry-grid.secondary .entry-card footer i{margin-top:0}.people-note{padding:80px 0;background:#e6d8c1}.people-note>div{display:grid;grid-template-columns:.5fr 1fr 1fr auto;gap:35px;align-items:center}.people-note h2{font:35px Georgia;margin:0}.people-note p{color:#69706b;margin:0}.people-note a{font-size:9px;text-transform:uppercase;letter-spacing:.1em;border-bottom:1px solid}.accent-gold{--culture-color:#b9892d}.accent-blue{--culture-color:#66888a}.accent-red{--culture-color:#a94e39}.accent-green{--culture-color:#70876d}.accent-clay{--culture-color:#b87550}.accent-indigo{--culture-color:#475b72}@media(max-width:900px){.entry-grid.secondary{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:800px){.section-index{padding:35px 0 80px}.index-heading,.group-heading,.people-note>div{grid-template-columns:1fr;gap:20px}.entry-grid,.entry-grid.featured{grid-template-columns:repeat(2,minmax(0,1fr))}.entry-grid.featured .entry-card,.entry-grid.featured .entry-card:nth-child(4),.entry-grid.featured .entry-card:nth-child(5){grid-column:auto}.entry-card>div{height:140px}.entry-card h2{font-size:23px}.entry-card>p{min-height:95px}}@media(max-width:520px){.entry-grid,.entry-grid.featured,.entry-grid.secondary{grid-template-columns:1fr}.entry-card>p,.entry-grid.secondary .entry-card>p{min-height:0}}
</style>
