---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
interface Props { entry: CollectionEntry<'culture'>; sectionName: string; }
const { entry, sectionName } = Astro.props;
const { Content } = await render(entry);
const videos = entry.data.videos ?? [];
const mediaHeading = entry.data.kind === 'Language' ? `Hear ${entry.data.title}` : 'Watch and listen';
const mediaIntro = entry.data.kind === 'Language'
  ? `Hear ${entry.data.title} in conversation, storytelling and public life.`
  : 'External recordings offer another way into this living culture.';
const [foods,people,places,history] = await Promise.all([getCollection('foods'),getCollection('people'),getCollection('places'),getCollection('history')]);
const related = [
  ...entry.data.relatedFoods.map(id=>{const item=foods.find(value=>value.id===id);return item&&{label:'Food',title:item.data.name,href:`/foods/${item.id}/`};}),
  ...entry.data.relatedPeople.map(id=>{const item=people.find(value=>value.id===id);return item&&{label:'Person',title:item.data.name,href:`/people/${item.id}/`};}),
  ...entry.data.relatedPlaces.map(id=>{const item=places.find(value=>value.id===id);return item&&{label:'Place',title:item.data.name,href:`/places/${item.id}/`};}),
  ...entry.data.relatedHistory.map(id=>{const item=history.find(value=>value.id===id);return item&&{label:'History',title:item.data.title,href:`/history/${item.id}/`};}),
].filter(Boolean) as {label:string;title:string;href:string}[];
---
<SiteLayout title={entry.data.title} description={entry.data.summary} eyebrow={`${entry.data.kind} · ${entry.data.region}`} heading={entry.data.title} intro={entry.data.summary}>
  <article class="culture-profile"><nav class="crumb wrap" aria-label="Breadcrumb"><a href="/culture/">Culture</a><span>→</span><a href={`/culture/${entry.data.section}/`}>{sectionName}</a><span>→</span><b>{entry.data.title}</b></nav><div class="facts wrap"><div><small>Section</small><strong>{sectionName}</strong></div><div><small>Season</small><strong>{entry.data.season}</strong></div><div><small>Region</small><strong>{entry.data.region}</strong></div>{entry.data.localName && <div><small>Also written</small><strong>{entry.data.localName}</strong></div>}</div><div class="body wrap"><aside><span>Living Bihar</span><p>This entry is an editorial starting point. It will grow through reported voices, regional distinctions and sources.</p><a href="/people/">Meet the people →</a></aside><div class="prose"><Content /></div></div>{videos.length > 0 && <section class:list={['media', 'wrap', { 'single-video': videos.length === 1 }]}><div class="media-heading"><p class="tag">Listen and watch</p><h2>{mediaHeading}</h2><p>{mediaIntro}</p></div><div class="video-grid">{videos.map(video => <figure><div class="video-frame"><iframe src={`https://www.youtube-nocookie.com/embed/${video.youtubeId}`} title={video.title} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe></div><figcaption><strong>{video.title}</strong><span>{video.caption}</span><a href={`https://www.youtube.com/watch?v=${video.youtubeId}`} target="_blank" rel="noreferrer">Watch on YouTube · {video.channel} ↗</a></figcaption></figure>)}</div></section>}{entry.data.sources.length > 0 && <section class="sources wrap"><p>Starting references</p><ul>{entry.data.sources.map(source => <li><a href={source.url} target="_blank" rel="noreferrer">{source.label} ↗</a></li>)}</ul></section>}<div class="next wrap"><a href={`/culture/${entry.data.section}/`}>← Return to {sectionName}</a><a href="/people/">Explore People →</a></div></article>
  {related.length>0&&<section class="connections wrap"><p class="tag">Connected subjects</p><div>{related.map(item=><a href={item.href}><small>{item.label}</small><strong>{item.title}</strong><span>↗</span></a>)}</div></section>}
</SiteLayout>
<style>
  .culture-profile{padding-bottom:110px}.crumb{display:flex;flex-wrap:wrap;gap:10px;padding-top:22px;font-size:8px;text-transform:uppercase;letter-spacing:.08em;color:#69706b}.crumb a{border-bottom:1px solid}.crumb b{color:#142c27}.facts{display:grid;grid-template-columns:repeat(4,1fr);border-bottom:1px solid rgba(20,44,39,.16);margin-top:22px}.facts>div{padding:27px 22px;border-right:1px solid rgba(20,44,39,.16)}.facts small,.facts strong{display:block}.facts small,.body aside span{font-size:9px;text-transform:uppercase;letter-spacing:.13em;color:#a9432e}.facts strong{font:17px Georgia;font-weight:normal;margin-top:7px}.body{display:grid;grid-template-columns:200px minmax(0,680px);justify-content:center;gap:70px;padding-top:75px}.body aside p{font-size:12px;color:#69706b}.body aside a{font-size:9px;text-transform:uppercase;border-bottom:1px solid}.prose{font:19px/1.85 Georgia;color:#3e4b47}.prose :global(p:first-child){font-size:27px;color:#142c27}.prose :global(h2){font:38px/1.15 Georgia;color:#142c27;margin:52px 0 16px}.sources{max-width:900px;margin-top:60px;border-top:1px solid rgba(20,44,39,.16);padding-top:25px}.sources>p{font-size:9px;text-transform:uppercase;letter-spacing:.12em;color:#a9432e}.sources ul{padding:0;list-style:none}.sources li{margin:10px 0}.sources a{font-size:12px;border-bottom:1px solid}.next{margin-top:70px;background:#142c27;color:#f4eee2;padding:32px;display:flex;justify-content:space-between;font-size:9px;text-transform:uppercase;letter-spacing:.1em}@media(max-width:700px){.facts{grid-template-columns:1fr 1fr}.facts>div:nth-child(2n){border-right:0}.body{grid-template-columns:1fr;gap:30px;padding-top:50px}.next{flex-direction:column;gap:18px}}
  .media{max-width:1000px;margin-top:70px;padding-top:30px;border-top:1px solid rgba(20,44,39,.16)}.media-heading{display:grid;grid-template-columns:150px 1fr 1fr;gap:30px;align-items:start;margin-bottom:28px}.media-heading h2{font:35px/1 Georgia;margin:0}.media-heading>p:last-child{font-size:12px;color:#69706b;margin:0;max-width:300px}.video-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}.video-grid figure{margin:0;background:#142c27;color:#f4eee2}.single-video .video-grid{grid-template-columns:1fr}.single-video .video-grid figure{display:grid;grid-template-columns:minmax(0,1.7fr) minmax(260px,.8fr)}.video-frame{position:relative;aspect-ratio:16/9;background:#0c1d19}.video-frame iframe{position:absolute;inset:0;width:100%;height:100%;border:0}.video-grid figcaption{padding:24px;display:flex;flex-direction:column;justify-content:center}.video-grid figcaption strong,.video-grid figcaption span,.video-grid figcaption a{display:block}.video-grid figcaption strong{font:21px/1.25 Georgia}.video-grid figcaption span{font-size:11px;line-height:1.6;color:rgba(255,255,255,.65);margin-top:10px}.video-grid figcaption a{font-size:8px;text-transform:uppercase;letter-spacing:.08em;color:#e9a93a;margin-top:22px}.sources{max-width:900px;margin-top:60px;border-top:1px solid rgba(20,44,39,.16);padding-top:25px}.sources>p{font-size:9px;text-transform:uppercase;letter-spacing:.12em;color:#a9432e}.sources ul{padding:0;list-style:none}.sources li{margin:10px 0}.sources a{font-size:12px;border-bottom:1px solid}.next{margin-top:70px;background:#142c27;color:#f4eee2;padding:32px;display:flex;justify-content:space-between;font-size:9px;text-transform:uppercase;letter-spacing:.1em}@media(max-width:700px){.facts{grid-template-columns:1fr 1fr}.facts>div:nth-child(2n){border-right:0}.body{grid-template-columns:1fr;gap:30px;padding-top:50px}.media-heading{grid-template-columns:1fr;gap:12px}.video-grid,.single-video .video-grid figure{grid-template-columns:1fr}.video-grid figcaption{min-height:190px}.next{flex-direction:column;gap:18px}}
  .connections{margin-top:-45px;margin-bottom:100px;padding-top:25px;border-top:1px solid rgba(20,44,39,.16)}.connections>div{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.connections a{background:#fff;padding:18px;display:grid;grid-template-columns:1fr auto}.connections small{grid-column:1/-1;font-size:8px;text-transform:uppercase;color:#a9432e}.connections strong{font:21px Georgia}@media(max-width:700px){.connections>div{grid-template-columns:1fr}}
</style>
