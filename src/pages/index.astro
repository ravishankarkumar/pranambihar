---
import { getCollection } from 'astro:content';
const marks: Record<string,string> = { places:'यात्रा', food:'स्वाद', culture:'कला', people:'लोग', history:'ज्ञान', now:'आज' };
const tones = ['ochre','blue','red'];
const featuredStories = (await getCollection('stories')).filter(story => story.data.featured).slice(0,3).map((story,index) => ({
  id: story.id,
  tag: story.data.pillarLabel,
  title: story.data.title,
  text: story.data.dek,
  tone: tones[index],
  mark: marks[story.data.pillar],
}));
const escapes = (await getCollection('journeys')).filter(journey => journey.data.featured).slice(0,4);
const placeIds = ['bodh-gaya', 'rajgir', 'valmiki-tiger-reserve', 'patna'];
const allPlaces = await getCollection('places');
const places = placeIds.map(id => allPlaces.find(place => place.id === id)).filter(place => place !== undefined);

const foodIds = ['litti-chokha', 'champaran-meat', 'thekua', 'silao-khaja'];
const allFoods = await getCollection('foods');
const foods = foodIds.map(id => allFoods.find(food => food.id === id)).filter(food => food !== undefined);

const cultureSections = [
  { href: '/culture/festivals/', label: 'Festivals', mark: 'उत्सव' },
  { href: '/culture/languages/', label: 'Languages', mark: 'भाषा' },
  { href: '/culture/art-craft/', label: 'Art & craft', mark: 'कला' },
  { href: '/culture/textiles/', label: 'Textiles', mark: 'वस्त्र' },
  { href: '/culture/music-performance/', label: 'Music & performance', mark: 'सुर' },
  { href: '/culture/traditions/', label: 'Traditions', mark: 'रीति' },
  { href: '/culture/living-memory/', label: 'Living memory', mark: 'स्मृति' },
];

const historyIds = ['magadha-rises', 'nalanda-mahavihara', 'champaran-satyagraha'];
const allHistory = await getCollection('history');
const history = historyIds.map(id => allHistory.find(item => item.id === id)).filter(item => item !== undefined);

const peopleIds = ['vashishtha-narayan-singh', 'dashrath-manjhi', 'sita-devi'];
const allPeople = await getCollection('people');
const people = peopleIds.map(id => allPeople.find(person => person.id === id)).filter(person => person !== undefined);

const portals = [
  ['Food', '/foods/', 'स्वाद'], ['Places', '/places/', 'यात्रा'], ['Escapes', '/escapes/', 'राह'],
  ['Culture', '/culture/', 'कला'], ['History', '/history/', 'काल'], ['People', '/people/', 'लोग'], ['Stories', '/stories/', 'कथा'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Pranam Bihar celebrates the people, places, history, food and living culture of Bihar." />
    <meta name="theme-color" content="#f4eee2" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Pranam Bihar — Stories from the heart of India</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="#top" aria-label="Pranam Bihar home">
        <span class="brand-mark">प</span>
        <span><strong>PRANAM</strong><small>BIHAR</small></span>
      </a>
      <button class="menu-button" aria-expanded="false" aria-controls="main-nav"><span></span><span></span></button>
      <nav id="main-nav" aria-label="Main navigation">
        <a href="/foods/">Food</a><a href="/places/">Places</a><a href="/escapes/">Escapes</a><a href="/culture/">Culture</a><a href="/history/">History</a><a href="/people/">People</a><a href="/stories/">Stories</a>
      </nav>
    </header>

    <main id="top">
      <section class="hero">
        <img class="hero-image" src="/images/bihar-depicted.png" alt="An illustrated dawn over the Ganga, with people, a boat and Bihar's historic landscape" />
        <div class="hero-shade"></div>
        <div class="hero-content">
          <p class="eyebrow light"><span></span> Stories from the heart of India</p>
          <h1>A land worth<br/><em>knowing.</em></h1>
          <p class="hero-copy">Beyond the headlines is a Bihar of boundless talent, ancient wisdom, quiet beauty and people who keep moving the world forward.</p>
          <div class="hero-actions">
            <a class="button primary" href="#explore">Begin exploring <span>→</span></a>
            <a class="text-link light-link" href="#about"><span class="play">▶</span> Why Pranam Bihar?</a>
          </div>
        </div>
        <p class="image-caption">The Ganga at dawn · An artist’s impression</p>
        <a class="scroll-cue" href="#explore" aria-label="Scroll to explore Bihar"><span>SCROLL</span><i>↓</i></a>
      </section>

      <section class="intro wrap" id="explore">
        <div class="directory-heading"><div><p class="section-kicker">Explore Bihar</p><h2>Seven ways<br/><em>to begin.</em></h2></div><p>Follow what draws you in—a meal, a journey, a voice, a life or a story—and discover the connections between them.</p></div>
        <nav class="portal-grid" aria-label="Explore Pranam Bihar">
          {portals.map(([label, href, mark], index) => (
            <a href={href}><small>{String(index + 1).padStart(2, '0')}</small><b>{mark}</b><span>{label}</span><i>↗</i></a>
          ))}
        </nav>
      </section>

      <section class="chhath-feature">
        <div class="wrap chhath-inner">
          <div class="chhath-sun" aria-hidden="true"><span>छठ</span><small>संध्या · उषा</small></div>
          <div class="chhath-copy">
            <p class="section-kicker">Festival in focus</p>
            <h2>Where Bihar<br/><em>greets the sun.</em></h2>
            <p>Chhath moves through fasting, preparation, water, family labour and carefully arranged offerings—culminating in prayers to the setting and rising sun.</p>
            <div class="chhath-actions"><a class="button chhath-primary" href="/culture/festivals/chhath/">Experience Chhath <span>→</span></a><a class="text-link" href="/foods/prasad/">Explore its prasad <span>→</span></a></div>
          </div>
          <div class="chhath-journey" aria-label="The four days of Chhath">
            <p><span>01</span><b>Nahay Khay</b></p>
            <p><span>02</span><b>Kharna</b></p>
            <p><span>03</span><b>Sandhya Arghya</b></p>
            <p><span>04</span><b>Usha Arghya</b></p>
          </div>
        </div>
      </section>

      <section class="stories wrap" id="stories">
        <div class="section-heading">
          <div><p class="section-kicker">Fresh from Bihar</p><h2>Stories to carry<br/><em>with you.</em></h2></div>
          <a class="text-link desktop-link" href="/stories/">View all stories <span>→</span></a>
        </div>
        <div class="story-grid">
          {featuredStories.map((story, i) => (
            <article class={`story-card ${i === 0 ? 'featured' : ''}`}>
              <div class={`story-art ${story.tone}`}><span>{story.mark}</span><i>{String(i + 1).padStart(2, '0')}</i></div>
              <div class="story-body"><p class="card-tag">{story.tag}</p><h3>{story.title}</h3><p>{story.text}</p><a href={`/stories/${story.id}/`} aria-label={`Read ${story.title}`}>↗</a></div>
            </article>
          ))}
        </div>
      </section>

      <section class="travel-band" id="places">
        <div class="wrap">
          <div class="section-heading travel-heading">
            <div><p class="section-kicker pale">Plan your Bihar</p><h2>Find a place.<br/><em>Take the road.</em></h2></div>
            <div class="travel-intro"><p>Discover the places first, then choose a practical day trip or slow weekend built around them.</p><div><a class="text-link light-link" href="/places/">All places <span>→</span></a><a class="text-link light-link" href="/escapes/">All escapes <span>→</span></a></div></div>
          </div>
          <div class="travel-places">
            {places.map((place, index) => (
              <a class="travel-place" href={`/places/${place.id}/`}><small>{String(index + 1).padStart(2, '0')}</small><span><strong>{place.data.name}</strong><em>{place.data.tagline}</em></span><i>↗</i></a>
            ))}
          </div>
          <div class="escape-grid travel-escapes">
            {escapes.map((escape, index) => (
              <a class={`escape-card escape-${escape.data.accent}`} href={`/escapes/${escape.id}/`}>
                <span>{String(index + 1).padStart(2, '0')} · FROM {escape.data.startFrom}</span>
                <h3>{escape.data.title}</h3>
                <p>{escape.data.summary}</p>
                <div class="card-meta"><b>{escape.data.duration}</b><i>View itinerary ↗</i></div>
              </a>
            ))}
          </div>
        </div>
      </section>

      <section class="food-home">
        <div class="wrap">
          <div class="section-heading food-heading">
            <div><p class="section-kicker">Taste Bihar</p><h2>A table shaped by<br/><em>place and season.</em></h2></div>
            <div class="food-intro"><p>Begin with familiar favourites, then explore snacks with chai, complete combinations, sweets and the prasads prepared for Bihar’s festivals and pujas.</p><a class="text-link" href="/foods/">Enter the food atlas <span>→</span></a></div>
          </div>
          <div class="food-showcase">
            {foods.map((food, index) => (
              <a class={`food-tile food-${food.data.accent}`} href={`/foods/${food.id}/`}><span>{food.data.localName || 'बिहार'}</span><small>0{index + 1} · {food.data.category}</small><h3>{food.data.name}</h3><p>{food.data.description}</p><i>Explore ↗</i></a>
            ))}
          </div>
          <nav class="food-paths" aria-label="More ways to explore Bihar's food"><a href="/foods/snacks/"><small>Chai & small hunger</small><strong>Snacks of Bihar</strong><i>↗</i></a><a href="/foods/combinations/"><small>Complete plates</small><strong>Food combinations</strong><i>↗</i></a><a href="/foods/prasad/"><small>Festival & puja</small><strong>Prasad of Bihar</strong><i>↗</i></a><a href="/foods/sweets/"><small>Place & craft</small><strong>Sweets of Bihar</strong><i>↗</i></a></nav>
        </div>
      </section>

      <section class="culture-home">
        <div class="wrap">
          <div class="culture-lead"><p class="section-kicker pale">Bihar in practice</p><h2>Culture in voice,<br/><em>line and movement.</em></h2><p>Not a cabinet of old things, but a living atlas of what people speak, make, perform, celebrate and carry forward.</p><a class="button outline" href="/culture/">Enter culture <span>→</span></a></div>
          <nav class="culture-paths" aria-label="Explore Bihar's culture">{cultureSections.map((item, index) => <a href={item.href}><small>0{index + 1}</small><b>{item.mark}</b><span>{item.label}</span><i>↗</i></a>)}</nav>
        </div>
      </section>

      <section class="legacy-home" id="people">
        <div class="wrap">
          <div class="section-heading legacy-heading"><div><p class="section-kicker">Time & lives</p><h2>The past speaks.<br/><em>People answer.</em></h2></div><p class="heading-note">Move through Bihar’s historical turning points and meet the people who made knowledge, art and possibility travel.</p></div>
          <div class="legacy-grid">
            <div class="history-list"><p class="column-label">Bihar through time</p>{history.map((item, index) => <a href={`/history/${item.id}/`}><small>0{index + 1} · {item.data.dateLabel}</small><h3>{item.data.title}</h3><p>{item.data.summary}</p><i>↗</i></a>)}<a class="text-link collection-link" href="/history/">Explore all history <span>→</span></a></div>
            <div class="people-list"><p class="column-label">People who showed the way</p>{people.map((person, index) => <a href={`/people/${person.id}/`}><b class={`mini-portrait p${index + 1}`}>{person.data.name.split(' ').map(word => word[0]).join('').slice(0,2)}</b><span><small>{person.data.knownFor}</small><h3>{person.data.name}</h3><p>{person.data.summary}</p></span><i>↗</i></a>)}<a class="text-link collection-link" href="/people/">Meet more people <span>→</span></a></div>
          </div>
        </div>
      </section>

      <section class="manifesto" id="about">
        <div class="manifesto-mark">प्र</div>
        <div class="manifesto-copy"><p class="section-kicker pale">Why Pranam Bihar</p><blockquote>“To tell better stories about a place is to imagine a better future for it.”</blockquote><p>Bihar is not only a story of what was. Pranam Bihar looks at a living, changing place with curiosity, care and pride—never nostalgia alone.</p><a class="text-link light-link" href="/about/">Read our story <span>→</span></a></div>
      </section>
    </main>

    <footer>
      <div class="wrap footer-top"><a class="brand footer-brand" href="#top"><span class="brand-mark">प</span><span><strong>PRANAM</strong><small>BIHAR</small></span></a><p>Looking at Bihar with fresh eyes.<br/>Telling the stories that deserve to travel.</p><nav><a href="/foods/">Food</a><a href="/places/">Places</a><a href="/escapes/">Escapes</a><a href="/culture/">Culture</a><a href="/history/">History</a><a href="/people/">People</a><a href="/stories/">Stories</a><a href="/about/">About</a><a href="/editorial-standards/">Standards</a></nav></div>
      <div class="wrap footer-bottom"><span>© {new Date().getFullYear()} Pranam Bihar</span><span>Made with respect in Bihar</span></div>
    </footer>

    <script>
      const menuButton = document.querySelector('.menu-button');
      const nav = document.querySelector('#main-nav');
      menuButton?.addEventListener('click', () => {
        const open = menuButton.getAttribute('aria-expanded') === 'true';
        menuButton.setAttribute('aria-expanded', String(!open));
        nav?.classList.toggle('open');
      });
      nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
        nav.classList.remove('open'); menuButton?.setAttribute('aria-expanded', 'false');
      }));
    </script>
  </body>
</html>

<style is:global>
  :root{--ink:#142c27;--cream:#f4eee2;--paper:#fbf8f1;--gold:#e9a93a;--red:#a9432e;--blue:#285a63;--muted:#6a706b;--line:rgba(20,44,39,.17)}
  *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:1.6}a{color:inherit;text-decoration:none}h1,h2,h3,p{margin-top:0}h1,h2,h3,blockquote{font-family:Georgia,'Times New Roman',serif}.wrap{width:min(1180px,calc(100% - 80px));margin-inline:auto}.site-header{height:90px;padding:0 5vw;display:flex;align-items:center;justify-content:space-between;background:rgba(251,248,241,.96);position:absolute;top:0;z-index:20;width:100%;border-bottom:1px solid rgba(255,255,255,.15)}.brand{display:flex;align-items:center;gap:12px;line-height:1}.brand-mark{width:42px;height:42px;display:grid;place-items:center;color:var(--cream);background:var(--ink);border-radius:50%;font:700 22px Georgia}.brand strong,.brand small{display:block;letter-spacing:.18em}.brand strong{font-size:14px}.brand small{font-size:10px;margin-top:6px;color:var(--red)}.site-header nav{display:flex;gap:34px;font-size:13px;font-weight:700}.site-header nav a{position:relative}.site-header nav a:after{content:'';height:1px;width:0;background:var(--red);position:absolute;left:0;bottom:-7px;transition:.25s}.site-header nav a:hover:after{width:100%}.header-cta{font-size:12px;text-transform:uppercase;letter-spacing:.12em;font-weight:700}.header-cta span{color:var(--red);font-size:17px;margin-left:8px}.menu-button{display:none;border:0;background:none}.hero{min-height:780px;height:100vh;position:relative;color:white;display:flex;align-items:center;overflow:hidden}.hero-image,.hero-shade{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.hero-shade{background:linear-gradient(90deg,rgba(7,29,25,.79) 0%,rgba(7,29,25,.45) 39%,rgba(7,29,25,.05) 70%),linear-gradient(0deg,rgba(7,29,25,.38),transparent 45%)}.hero-content{z-index:2;margin-left:max(7vw,calc((100% - 1180px)/2));width:min(640px,50vw);padding-top:75px}.eyebrow,.section-kicker{font-size:11px;letter-spacing:.22em;text-transform:uppercase;font-weight:800;margin-bottom:24px}.eyebrow{display:flex;align-items:center;gap:12px}.eyebrow span{width:36px;height:1px;background:var(--gold)}.light{color:#f6d69a}.hero h1{font-size:clamp(66px,7.6vw,116px);line-height:.82;letter-spacing:-.055em;margin-bottom:34px;font-weight:400}.hero h1 em,h2 em{font-weight:400;color:var(--gold)}.hero-copy{max-width:540px;font-size:18px;line-height:1.65;color:rgba(255,255,255,.86)}.hero-actions{display:flex;gap:30px;align-items:center;margin-top:35px}.button{display:inline-flex;align-items:center;justify-content:space-between;gap:30px;padding:15px 19px;text-transform:uppercase;letter-spacing:.12em;font-size:11px;font-weight:800;min-width:190px}.button span{font-size:18px}.primary{background:var(--gold);color:var(--ink)}.primary:hover{background:#f2c66c}.text-link{display:inline-flex;gap:12px;align-items:center;font-size:11px;text-transform:uppercase;letter-spacing:.15em;font-weight:800;border-bottom:1px solid var(--ink);padding-bottom:5px}.light-link{border-color:rgba(255,255,255,.45)}.play{width:30px;height:30px;border:1px solid rgba(255,255,255,.55);border-radius:50%;display:grid;place-items:center;font-size:8px;padding-left:2px}.image-caption{position:absolute;z-index:2;right:4vw;bottom:35px;font-size:10px;letter-spacing:.1em;color:rgba(255,255,255,.72)}.scroll-cue{position:absolute;z-index:2;left:3vw;bottom:34px;display:flex;flex-direction:column;gap:10px;align-items:center}.scroll-cue span{font-size:9px;letter-spacing:.25em;writing-mode:vertical-rl}.scroll-cue i{font-style:normal;color:var(--gold)}.intro{padding:130px 0}.section-kicker{color:var(--red);margin-bottom:30px}.intro-grid{display:grid;grid-template-columns:1fr 1fr;gap:9vw}.intro h2,.section-heading h2,.places h2,.newsletter h2{font-size:clamp(46px,5.4vw,76px);line-height:.98;letter-spacing:-.04em;font-weight:400;margin:0}.intro .lead{font:26px/1.45 Georgia;color:var(--ink)}.intro-grid>div p:not(.lead){color:var(--muted);max-width:550px}.intro .text-link{margin-top:18px}.stories{padding:30px 0 140px}.section-heading{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:58px}.story-grid{display:grid;grid-template-columns:1.2fr 1fr 1fr;gap:24px}.story-card{background:#fff;border:1px solid var(--line);transition:transform .3s,box-shadow .3s}.story-card:hover{transform:translateY(-6px);box-shadow:0 18px 45px rgba(20,44,39,.1)}.story-art{height:260px;display:grid;place-items:center;position:relative;overflow:hidden}.featured .story-art{height:330px}.story-art:before,.story-art:after{content:'';position:absolute;border:1px solid currentColor;border-radius:50%;width:190px;height:190px;opacity:.25}.story-art:after{width:130px;height:130px}.story-art span{font:52px Georgia;z-index:1}.story-art i{position:absolute;bottom:15px;right:18px;font:italic 14px Georgia}.ochre{background:#d9a94c;color:#482c16}.blue{background:#66888a;color:#edf0e9}.red{background:#b05a43;color:#f6e8d5}.story-body{padding:28px;position:relative}.card-tag{text-transform:uppercase;letter-spacing:.18em;font-size:10px;color:var(--red);font-weight:800;margin-bottom:12px}.story-body h3,.person-card h3{font-size:27px;line-height:1.15;margin-bottom:13px}.story-body>p:last-of-type{font-size:14px;color:var(--muted);line-height:1.55}.story-body>a{position:absolute;right:25px;top:27px}.places{background:var(--ink);color:var(--cream);padding:120px 0}.places-inner{display:grid;grid-template-columns:.78fr 1.22fr;gap:9vw;align-items:start}.pale{color:#d7aa5a}.places-copy>p:not(.section-kicker){color:rgba(255,255,255,.61);max-width:400px;margin:30px 0}.outline{border:1px solid rgba(255,255,255,.38);margin-top:14px}.place-list{border-top:1px solid rgba(255,255,255,.18)}.place-row{display:grid;grid-template-columns:30px 70px 1fr 30px;align-items:center;padding:25px 0;border-bottom:1px solid rgba(255,255,255,.18);transition:padding .25s}.place-row:hover{padding-left:12px}.place-row small{font-size:10px;color:#d7aa5a}.place-row>b{font:35px Georgia;color:#d7a