---
import { getCollection } from 'astro:content';
const marks: Record<string,string> = { places:'यात्रा', food:'स्वाद', culture:'कला', people:'लोग', history:'ज्ञान', now:'आज' };
const tones = ['ochre','blue','red'];
const featuredStories = (await getCollection('stories')).filter(story => story.data.featured).slice(0,3).map((story,index) => ({
  id: story.id,
  tag: story.data.pillarLabel,
  title: story.data.title,
  text: story.data.dek,
  tone: tones[index],
  mark: marks[story.data.pillar],
}));

const places = [
  { number: '01', name: 'Bodh Gaya', note: 'Where silence changed the world', symbol: '◉' },
  { number: '02', name: 'Rajgir', note: 'Hills, hot springs & old stories', symbol: '△' },
  { number: '03', name: 'Valmiki', note: 'The wild green edge of Bihar', symbol: '⌁' },
  { number: '04', name: 'Patna', note: 'A river city, always becoming', symbol: '≈' },
];

const people = [
  { initials: 'VS', name: 'Vashishtha Narayan Singh', role: 'Mathematician', quote: 'A mind that made the impossible feel within reach.' },
  { initials: 'DK', name: 'Dashrath Manjhi', role: 'The Mountain Man', quote: 'One person. One hammer. A road where none existed.' },
  { initials: 'SD', name: 'Sita Devi', role: 'Madhubani artist', quote: 'She carried Mithila’s lines from village walls to the world.' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Pranam Bihar celebrates the people, places, history, food and living culture of Bihar." />
    <meta name="theme-color" content="#f4eee2" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Pranam Bihar — Stories from the heart of India</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="#top" aria-label="Pranam Bihar home">
        <span class="brand-mark">प</span>
        <span><strong>PRANAM</strong><small>BIHAR</small></span>
      </a>
      <button class="menu-button" aria-expanded="false" aria-controls="main-nav"><span></span><span></span></button>
      <nav id="main-nav" aria-label="Main navigation">
        <a href="/stories/">Stories</a><a href="/places/">Places</a><a href="/people/">People</a><a href="/about/">About Bihar</a>
      </nav>
      <a class="header-cta" href="/stories/">Explore Bihar <span>↗</span></a>
    </header>

    <main id="top">
      <section class="hero">
        <img class="hero-image" src="/images/bihar-depicted.png" alt="An illustrated dawn over the Ganga, with people, a boat and Bihar's historic landscape" />
        <div class="hero-shade"></div>
        <div class="hero-content">
          <p class="eyebrow light"><span></span> Stories from the heart of India</p>
          <h1>A land worth<br/><em>knowing.</em></h1>
          <p class="hero-copy">Beyond the headlines is a Bihar of boundless talent, ancient wisdom, quiet beauty and people who keep moving the world forward.</p>
          <div class="hero-actions">
            <a class="button primary" href="#stories">Begin exploring <span>→</span></a>
            <a class="text-link light-link" href="#about"><span class="play">▶</span> Why Pranam Bihar?</a>
          </div>
        </div>
        <p class="image-caption">The Ganga at dawn · An artist’s impression</p>
        <a class="scroll-cue" href="#intro" aria-label="Scroll to introduction"><span>SCROLL</span><i>↓</i></a>
      </section>

      <section class="intro wrap" id="intro">
        <p class="section-kicker">Our Bihar</p>
        <div class="intro-grid">
          <h2>Old soul.<br/><em>New stories.</em></h2>
          <div>
            <p class="lead">Bihar is not a story of what was. It is a living, changing place—rooted in history and alive with possibility.</p>
            <p>Pranam Bihar is an independent celebration of the state in all its depth: the knowledge it gave the world, the beauty hidden in plain sight, and the people building what comes next.</p>
            <a class="text-link" href="/about/">Our story <span>→</span></a>
          </div>
        </div>
      </section>

      <section class="stories wrap" id="stories">
        <div class="section-heading">
          <div><p class="section-kicker">Fresh from Bihar</p><h2>Stories to carry<br/><em>with you.</em></h2></div>
          <a class="text-link desktop-link" href="/stories/">View all stories <span>→</span></a>
        </div>
        <div class="story-grid">
          {featuredStories.map((story, i) => (
            <article class={`story-card ${i === 0 ? 'featured' : ''}`}>
              <div class={`story-art ${story.tone}`}><span>{story.mark}</span><i>{String(i + 1).padStart(2, '0')}</i></div>
              <div class="story-body"><p class="card-tag">{story.tag}</p><h3>{story.title}</h3><p>{story.text}</p><a href={`/stories/${story.id}/`} aria-label={`Read ${story.title}`}>↗</a></div>
            </article>
          ))}
        </div>
      </section>

      <section class="places" id="places">
        <div class="wrap places-inner">
          <div class="places-copy">
            <p class="section-kicker pale">Go beyond the map</p>
            <h2>Places that<br/><em>stay with you.</em></h2>
            <p>Walk through histories older than memory. Find forests, rivers, sacred paths, and cities full of everyday wonder.</p>
            <a class="button outline" href="/places/">Explore Bihar <span>→</span></a>
          </div>
          <div class="place-list">
            {places.map((place) => (
              <a class="place-row" href="/places/"><small>{place.number}</small><b>{place.symbol}</b><span><strong>{place.name}</strong><em>{place.note}</em></span><i>↗</i></a>
            ))}
          </div>
        </div>
      </section>

      <section class="people wrap" id="people">
        <div class="section-heading">
          <div><p class="section-kicker">Made in Bihar</p><h2>People who<br/><em>showed the way.</em></h2></div>
          <p class="heading-note">Remarkable lives, remembered not as distant legends—but as proof of what is possible.</p>
        </div>
        <div class="people-grid">
          {people.map((person, i) => (
            <article class="person-card">
              <div class={`portrait p${i + 1}`}><span>{person.initials}</span></div>
              <p class="card-tag">{person.role}</p><h3>{person.name}</h3><p>“{person.quote}”</p><a class="text-link" href="/people/">Read their story <span>→</span></a>
            </article>
          ))}
        </div>
      </section>

      <section class="manifesto" id="about">
        <div class="manifesto-mark">प्र</div>
        <div class="manifesto-copy"><p class="section-kicker pale">A new way to see Bihar</p><blockquote>“To tell better stories about a place is to imagine a better future for it.”</blockquote><p>We look with curiosity, care and pride—never nostalgia alone.</p></div>
      </section>

      <section class="newsletter" id="explore">
        <div class="wrap newsletter-inner">
          <div><p class="section-kicker">Keep exploring</p><h2>Every corner has<br/><em>a story to tell.</em></h2></div>
          <div class="explore-links"><a href="/stories/">Read the stories <span>→</span></a><a href="/places/">Discover the places <span>→</span></a><a href="/people/">Meet the people <span>→</span></a></div>
        </div>
      </section>
    </main>

    <footer>
      <div class="wrap footer-top"><a class="brand footer-brand" href="#top"><span class="brand-mark">प</span><span><strong>PRANAM</strong><small>BIHAR</small></span></a><p>Looking at Bihar with fresh eyes.<br/>Telling the stories that deserve to travel.</p><nav><a href="/stories/">Stories</a><a href="/places/">Places</a><a href="/people/">People</a><a href="/about/">About</a><a href="/editorial-standards/">Standards</a></nav></div>
      <div class="wrap footer-bottom"><span>© {new Date().getFullYear()} Pranam Bihar</span><span>Made with respect in Bihar</span></div>
    </footer>

    <script>
      const menuButton = document.querySelector('.menu-button');
      const nav = document.querySelector('#main-nav');
      menuButton?.addEventListener('click', () => {
        const open = menuButton.getAttribute('aria-expanded') === 'true';
        menuButton.setAttribute('aria-expanded', String(!open));
        nav?.classList.toggle('open');
      });
      nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
        nav.classList.remove('open'); menuButton?.setAttribute('aria-expanded', 'false');
      }));
    </script>
  </body>
</html>

<style is:global>
  :root{--ink:#142c27;--cream:#f4eee2;--paper:#fbf8f1;--gold:#e9a93a;--red:#a9432e;--blue:#285a63;--muted:#6a706b;--line:rgba(20,44,39,.17)}
  *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:1.6}a{color:inherit;text-decoration:none}h1,h2,h3,p{margin-top:0}h1,h2,h3,blockquote{font-family:Georgia,'Times New Roman',serif}.wrap{width:min(1180px,calc(100% - 80px));margin-inline:auto}.site-header{height:90px;padding:0 5vw;display:flex;align-items:center;justify-content:space-between;background:rgba(251,248,241,.96);position:absolute;top:0;z-index:20;width:100%;border-bottom:1px solid rgba(255,255,255,.15)}.brand{display:flex;align-items:center;gap:12px;line-height:1}.brand-mark{width:42px;height:42px;display:grid;place-items:center;color:var(--cream);background:var(--ink);border-radius:50%;font:700 22px Georgia}.brand strong,.brand small{display:block;letter-spacing:.18em}.brand strong{font-size:14px}.brand small{font-size:10px;margin-top:6px;color:var(--red)}.site-header nav{display:flex;gap:34px;font-size:13px;font-weight:700}.site-header nav a{position:relative}.site-header nav a:after{content:'';height:1px;width:0;background:var(--red);position:absolute;left:0;bottom:-7px;transition:.25s}.site-header nav a:hover:after{width:100%}.header-cta{font-size:12px;text-transform:uppercase;letter-spacing:.12em;font-weight:700}.header-cta span{color:var(--red);font-size:17px;margin-left:8px}.menu-button{display:none;border:0;background:none}.hero{min-height:780px;height:100vh;position:relative;color:white;display:flex;align-items:center;overflow:hidden}.hero-image,.hero-shade{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.hero-shade{background:linear-gradient(90deg,rgba(7,29,25,.79) 0%,rgba(7,29,25,.45) 39%,rgba(7,29,25,.05) 70%),linear-gradient(0deg,rgba(7,29,25,.38),transparent 45%)}.hero-content{z-index:2;margin-left:max(7vw,calc((100% - 1180px)/2));width:min(640px,50vw);padding-top:75px}.eyebrow,.section-kicker{font-size:11px;letter-spacing:.22em;text-transform:uppercase;font-weight:800;margin-bottom:24px}.eyebrow{display:flex;align-items:center;gap:12px}.eyebrow span{width:36px;height:1px;background:var(--gold)}.light{color:#f6d69a}.hero h1{font-size:clamp(66px,7.6vw,116px);line-height:.82;letter-spacing:-.055em;margin-bottom:34px;font-weight:400}.hero h1 em,h2 em{font-weight:400;color:var(--gold)}.hero-copy{max-width:540px;font-size:18px;line-height:1.65;color:rgba(255,255,255,.86)}.hero-actions{display:flex;gap:30px;align-items:center;margin-top:35px}.button{display:inline-flex;align-items:center;justify-content:space-between;gap:30px;padding:15px 19px;text-transform:uppercase;letter-spacing:.12em;font-size:11px;font-weight:800;min-width:190px}.button span{font-size:18px}.primary{background:var(--gold);color:var(--ink)}.primary:hover{background:#f2c66c}.text-link{display:inline-flex;gap:12px;align-items:center;font-size:11px;text-transform:uppercase;letter-spacing:.15em;font-weight:800;border-bottom:1px solid var(--ink);padding-bottom:5px}.light-link{border-color:rgba(255,255,255,.45)}.play{width:30px;height:30px;border:1px solid rgba(255,255,255,.55);border-radius:50%;display:grid;place-items:center;font-size:8px;padding-left:2px}.image-caption{position:absolute;z-index:2;right:4vw;bottom:35px;font-size:10px;letter-spacing:.1em;color:rgba(255,255,255,.72)}.scroll-cue{position:absolute;z-index:2;left:3vw;bottom:34px;display:flex;flex-direction:column;gap:10px;align-items:center}.scroll-cue span{font-size:9px;letter-spacing:.25em;writing-mode:vertical-rl}.scroll-cue i{font-style:normal;color:var(--gold)}.intro{padding:130px 0}.section-kicker{color:var(--red);margin-bottom:30px}.intro-grid{display:grid;grid-template-columns:1fr 1fr;gap:9vw}.intro h2,.section-heading h2,.places h2,.newsletter h2{font-size:clamp(46px,5.4vw,76px);line-height:.98;letter-spacing:-.04em;font-weight:400;margin:0}.intro .lead{font:26px/1.45 Georgia;color:var(--ink)}.intro-grid>div p:not(.lead){color:var(--muted);max-width:550px}.intro .text-link{margin-top:18px}.stories{padding:30px 0 140px}.section-heading{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:58px}.story-grid{display:grid;grid-template-columns:1.2fr 1fr 1fr;gap:24px}.story-card{background:#fff;border:1px solid var(--line);transition:transform .3s,box-shadow .3s}.story-card:hover{transform:translateY(-6px);box-shadow:0 18px 45px rgba(20,44,39,.1)}.story-art{height:260px;display:grid;place-items:center;position:relative;overflow:hidden}.featured .story-art{height:330px}.story-art:before,.story-art:after{content:'';position:absolute;border:1px solid currentColor;border-radius:50%;width:190px;height:190px;opacity:.25}.story-art:after{width:130px;height:130px}.story-art span{font:52px Georgia;z-index:1}.story-art i{position:absolute;bottom:15px;right:18px;font:italic 14px Georgia}.ochre{background:#d9a94c;color:#482c16}.blue{background:#66888a;color:#edf0e9}.red{background:#b05a43;color:#f6e8d5}.story-body{padding:28px;position:relative}.card-tag{text-transform:uppercase;letter-spacing:.18em;font-size:10px;color:var(--red);font-weight:800;margin-bottom:12px}.story-body h3,.person-card h3{font-size:27px;line-height:1.15;margin-bottom:13px}.story-body>p:last-of-type{font-size:14px;color:var(--muted);line-height:1.55}.story-body>a{position:absolute;right:25px;top:27px}.places{background:var(--ink);color:var(--cream);padding:120px 0}.places-inner{display:grid;grid-template-columns:.78fr 1.22fr;gap:9vw;align-items:start}.pale{color:#d7aa5a}.places-copy>p:not(.section-kicker){color:rgba(255,255,255,.61);max-width:400px;margin:30px 0}.outline{border:1px solid rgba(255,255,255,.38);margin-top:14px}.place-list{border-top:1px solid rgba(255,255,255,.18)}.place-row{display:grid;grid-template-columns:30px 70px 1fr 30px;align-items:center;padding:25px 0;border-bottom:1px solid rgba(255,255,255,.18);transition:padding .25s}.place-row:hover{padding-left:12px}.place-row small{font-size:10px;color:#d7aa5a}.place-row>b{font:35px Georgia;color:#d7aa5a}.place-row span{display:flex;flex-direction:column}.place-row strong{font:28px Georgia}.place-row em{font-style:normal;font-size:12px;color:rgba(255,255,255,.55)}.place-row>i{font-style:normal}.people{padding:130px 0}.heading-note{max-width:350px;color:var(--muted);font:18px/1.5 Georgia}.people-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:32px}.portrait{height:330px;display:grid;place-items:center;margin-bottom:25px;background:#d2c4ad;position:relative;overflow:hidden}.portrait:before{content:'';width:180px;height:230px;border-radius:50% 50% 20% 20%;background:var(--ink);opacity:.85;position:absolute;bottom:-60px}.portrait span{z-index:1;color:var(--cream);font:40px Georgia}.p2{background:#ba805e}.p3{background:#9cad9c}.person-card>p:not(.card-tag){color:var(--muted);font:italic 15px/1.55 Georgia;min-height:50px}.manifesto{min-height:520px;background:var(--red);color:var(--cream);display:grid;grid-template-columns:.8fr 1.2fr;align-items:center;overflow:hidden}.manifesto-mark{font:380px/1 Georgia;color:rgba(255,255,255,.08);text-align:center}.manifesto-copy{max-width:700px;padding:70px}.manifesto blockquote{font-size:clamp(37px,4.7vw,66px);line-height:1.1;margin:0 0 25px}.manifesto-copy>p:last-child{color:rgba(255,255,255,.64)}.newsletter{padding:100px 0;background:#e6d8c1}.newsletter-inner{display:grid;grid-template-columns:1fr 1fr;gap:10vw;align-items:center}.newsletter form label{font-size:10px;letter-spacing:.16em;text-transform:uppercase;font-weight:800}.newsletter form>div{display:flex;border-bottom:1px solid var(--ink);margin-top:10px}.newsletter input{flex:1;background:none;border:0;padding:18px 0;font:18px Georgia;outline:0}.newsletter button{border:0;background:none;font-size:10px;text-transform:uppercase;letter-spacing:.12em;font-weight:bold}.newsletter button span{font-size:17px;margin-left:8px}.newsletter form p{font-size:11px;color:var(--muted);margin-top:12px}footer{background:#0c1d19;color:rgba(255,255,255,.7);padding:70px 0 25px}.footer-top{display:grid;grid-template-columns:1fr 1fr 1fr;align-items:start}.footer-brand{color:#fff}.footer-top>p{font:16px/1.6 Georgia}.footer-top nav{display:grid;grid-template-columns:1fr 1fr;gap:16px;font-size:12px;text-transform:uppercase;letter-spacing:.12em}.footer-bottom{border-top:1px solid rgba(255,255,255,.12);margin-top:55px;padding-top:22px;display:flex;justify-content:space-between;font-size:10px;letter-spacing:.1em;text-transform:uppercase}
  @media(max-width:800px){.wrap{width:min(100% - 36px,600px)}.site-header{height:72px;padding:0 20px;position:absolute}.site-header nav{position:absolute;left:0;right:0;top:72px;background:var(--paper);color:var(--ink);padding:25px;display:none;flex-direction:column;gap:24px}.site-header nav.open{display:flex}.header-cta{display:none}.menu-button{display:flex;flex-direction:column;gap:6px;padding:10px}.menu-button span{display:block;width:25px;height:1px;background:var(--ink)}.hero{height:auto;min-height:760px;align-items:flex-end;padding-bottom:100px}.hero-image{object-position:62% center}.hero-shade{background:linear-gradient(0deg,rgba(7,29,25,.9) 10%,rgba(7,29,25,.45) 66%,rgba(7,29,25,.2))}.hero-content{width:auto;margin:0 24px;padding:0}.hero h1{font-size:62px}.hero-copy{font-size:16px}.hero-actions{align-items:flex-start;flex-direction:column;gap:22px}.image-caption{display:none}.scroll-cue{display:none}.intro,.people{padding:90px 0}.intro-grid,.newsletter-inner,.places-inner{grid-template-columns:1fr;gap:45px}.story-grid,.people-grid{grid-template-columns:1fr}.section-heading{align-items:flex-start;gap:25px}.desktop-link{display:none}.stories{padding-bottom:90px}.featured .story-art,.story-art,.portrait{height:280px}.places{padding:90px 0}.place-row{grid-template-columns:25px 50px 1fr 20px}.place-row strong{font-size:23px}.people .section-heading{flex-direction:column}.manifesto{grid-template-columns:1fr;position:relative}.manifesto-mark{position:absolute;font-size:300px}.manifesto-copy{padding:85px 25px;z-index:1}.manifesto blockquote{font-size:38px}.newsletter{padding:80px 0}.newsletter form>div{flex-direction:column}.newsletter button{text-align:left;padding:15px 0}.footer-top{grid-template-columns:1fr;gap:38px}.footer-bottom{gap:25px;flex-direction:column}.brand-mark{width:38px;height:38px}}
  .explore-links{display:grid;border-top:1px solid var(--ink)}.explore-links a{display:flex;justify-content:space-between;padding:18px 0;border-bottom:1px solid rgba(20,44,39,.3);font:22px Georgia;transition:padding .2s}.explore-links a:hover{padding-left:10px}.explore-links span{font-family:Arial;font-size:17px}
</style>
