---
import SiteLayout from '../layouts/SiteLayout.astro';
const places=[['Bodh Gaya','Where silence changed the world','A place of pilgrimage and contemplation beneath the Bodhi tree.','/stories/'],['Nalanda','A landscape of learning','Walk through an institution’s archaeology, memory and continuing questions.','/stories/nalanda-before-metaphor/'],['Rajgir','Hills layered with history','Ancient paths, warm springs and a landscape sacred to many traditions.','/stories/rajgir-slowly/'],['Valmiki Tiger Reserve','Bihar’s wild green edge','Forests, grasslands and rivers at the foot of the Himalayan terai.','/stories/'],['Patna','A river city, always becoming','Museums, neighbourhoods, food and the long memory of Pataliputra.','/stories/'],['Mithila','A landscape drawn in lines','Living traditions, wetlands, food systems and a visual language known worldwide.','/stories/makhana-country/']];
---
<SiteLayout title="Places" description="Discover beautiful and historic places across Bihar." eyebrow="Go beyond the map" heading="Places that stay with you." intro="Sacred paths, ancient universities, river cities and wild forests—an evolving guide to seeing Bihar slowly and well.">
  <section class="collection"><div class="wrap feature-list">{places.map((p,i)=><a class="feature" href={p[3]}><small>{String(i+1).padStart(2,'0')}</small><h2>{p[0]}</h2><p><strong>{p[1]}</strong><br/>{p[2]}</p><span>↗</span></a>)}</div></section>
</SiteLayout>
