---
import SiteLayout from '../layouts/SiteLayout.astro';
const places=[['Bodh Gaya','Where silence changed the world','A place of pilgrimage and contemplation beneath the Bodhi tree.'],['Nalanda','The ruins of a world university','Walk through red-brick monasteries that once welcomed scholars from across Asia.'],['Rajgir','Hills layered with history','Ancient paths, warm springs and a landscape sacred to many traditions.'],['Valmiki Tiger Reserve','Bihar’s wild green edge','Forests, grasslands and rivers at the foot of the Himalayan terai.'],['Patna','A river city, always becoming','Museums, neighbourhoods, food and the long memory of Pataliputra.'],['Mithila','A landscape drawn in lines','Living traditions, village homes, wetlands and a visual language known worldwide.']];
---
<SiteLayout title="Places" description="Discover beautiful and historic places across Bihar." eyebrow="Go beyond the map" heading="Places that stay with you." intro="Sacred paths, ancient universities, river cities and wild forests—an evolving guide to seeing Bihar slowly and well.">
  <section class="collection"><div class="wrap feature-list">{places.map((p,i)=><article class="feature"><small>{String(i+1).padStart(2,'0')}</small><h2>{p[0]}</h2><p><strong>{p[1]}</strong><br/>{p[2]}</p><span>↗</span></article>)}</div></section>
</SiteLayout>
