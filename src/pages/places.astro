---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';

const places = (await getCollection('places')).sort((a,b) => Number(b.data.featured) - Number(a.data.featured) || a.data.name.localeCompare(b.data.name));
const journeys = (await getCollection('journeys')).sort((a,b) => Number(b.data.featured) - Number(a.data.featured));
const placeById = new Map(places.map(place => [place.id, place]));
const kinds = ['History & heritage','Nature','Sacred journey','City & culture'] as const;
---
<SiteLayout title="Places" description="Discover destinations and thoughtful weekend journeys across Bihar." eyebrow="Go beyond the map" heading="Places that stay with you." intro="Sacred paths, historic cities, river landscapes, forests and journeys designed for seeing Bihar slowly and well.">
  <section class="places-intro"><div class="wrap"><p>Begin with a destination—or choose a journey that connects several places through history, landscape and time.</p><div><strong>{places.length}</strong><span>places</span><strong>{journeys.length}</strong><span>journeys</span></div></div></section>
  <section class="destinations wrap">
    <div class="heading"><div><p class="tag">Destination atlas</p><h2>Find your way<br/><em>into Bihar.</em></h2></div><p>Each entry is a starting point. Practical details and reported local recommendations will deepen as the atlas grows.</p></div>
    {kinds.map((kind,index) => { const entries=places.filter(place => place.data.kind === kind); if(!entries.length) return null; return <section class="place-group"><div class="group-title"><span>0{index+1}</span><h3>{kind}</h3><p>{entries.length} places</p></div><div class="place-grid">{entries.map(place => <a class={`place-card accent-${place.data.accent}`} href={`/places/${place.id}/`}><div><span>{place.data.district}</span><b>{place.data.name.slice(0,1)}</b></div><small>{place.data.duration} · {place.data.bestSeason}</small><h4>{place.data.name}</h4><p>{place.data.tagline}</p><i>Explore ↗</i></a>)}</div></section>; })}
  </section>
  <section class="journeys" id="weekend-journeys"><div class="wrap"><div class="heading"><div><p class="tag">Weekend journeys</p><h2>Don’t just arrive.<br/><em>Follow a thread.</em></h2></div><p>Short itineraries that make sense as stories—not hurried lists of attractions.</p></div><div class="journey-grid">{journeys.map((journey,index) => <article class={`journey accent-${journey.data.accent}`}><span>{String(index+1).padStart(2,'0')} · FROM {journey.data.startFrom}</span><h3>{journey.data.title}</h3><p>{journey.data.summary}</p><div class="route">{journey.data.stops.map((stopId,i) => { const stop=placeById.get(stopId); return <>{stop && <a href={`/places/${stop.id}/`}>{stop.data.name}</a>}{i < journey.data.stops.length-1 && <i>→</i>}</>; })}</div><footer><b>{journey.data.duration}</b><small>{journey.data.bestFor.join(' · ')}</small></footer></article>)}</div><p class="travel-note">Travel conditions, opening times, seasonal access and local safety advice should always be confirmed before departure.</p></div></section>
</SiteLayout>
<style>
  .places-intro{background:#142c27;color:#f4eee2;padding:52px 0}.places-intro>div{display:grid;grid-template-columns:1.4fr 1fr;gap:60px;align-items:center}.places-intro p{font:22px/1.5 Georgia;margin:0}.places-intro>div>div{display:grid;grid-template-columns:auto 1fr auto 1fr;gap:12px;align-items:end}.places-intro strong{font:48px Georgia;color:#e9a93a}.places-intro span{text-transform:uppercase;letter-spacing:.13em;font-size:9px;padding-bottom:10px}.destinations{padding:100px 0 120px}.heading{display:grid;grid-template-columns:1fr 390px;gap:60px;align-items:end;margin-bottom:55px}.heading h2{font:clamp(46px,5.5vw,76px)/.98 Georgia;margin:14px 0 0}.heading h2 em{font-weight:normal;color:#e0a33c}.heading>p{color:#69706b}.place-group{margin-top:65px}.group-title{display:grid;grid-template-columns:45px 1fr auto;align-items:end;border-bottom:1px solid rgba(20,44,39,.2);padding-bottom:15px;margin-bottom:18px}.group-title span,.group-title p{font-size:9px;text-transform:uppercase;letter-spacing:.12em;color:#a9432e;margin:0}.group-title h3{font:32px Georgia;margin:0}.place-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}.place-card{background:#fff;border:1px solid rgba(20,44,39,.14);padding-bottom:20px;min-width:0}.place-card>div{height:150px;background:var(--place-color);color:#fff;display:grid;place-items:center;position:relative;overflow:hidden}.place-card>div:before{content:'';position:absolute;width:100px;height:100px;border:1px solid currentColor;border-radius:50%;opacity:.28}.place-card>div span{position:absolute;left:13px;top:12px;font-size:8px;text-transform:uppercase;letter-spacing:.08em}.place-card>div b{font:36px Georgia;font-weight:normal;z-index:1}.place-card>small,.place-card h4,.place-card>p,.place-card>i{display:block;margin-left:18px;margin-right:18px}.place-card>small{font-size:7px;text-transform:uppercase;letter-spacing:.08em;color:#a9432e;margin-top:16px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.place-card h4{font:25px/1.05 Georgia;margin-top:8px;margin-bottom:7px}.place-card>p{font-size:12px;color:#69706b;min-height:38px}.place-card>i{font-style:normal;font-size:9px;text-transform:uppercase;letter-spacing:.1em}.journeys{padding:100px 0;background:#e6d8c1}.journey-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}.journey{background:#fbf8f1;padding:32px;border-top:5px solid var(--place-color)}.journey>span{font-size:8px;text-transform:uppercase;letter-spacing:.11em;color:#a9432e}.journey h3{font:35px/1.05 Georgia;margin:28px 0 12px}.journey>p{color:#69706b;font-size:13px}.route{display:flex;gap:10px;align-items:center;margin:30px 0}.route a{font:18px Georgia;border-bottom:1px solid}.route i{font-style:normal;color:#a9432e}.journey footer{display:flex;justify-content:space-between;gap:20px;border-top:1px solid rgba(20,44,39,.15);padding-top:16px}.journey footer b,.journey footer small{text-transform:uppercase;font-size:8px;letter-spacing:.09em}.journey footer small{color:#69706b;text-align:right}.travel-note{font-size:11px;color:#69706b;margin:35px 0 0}.accent-gold{--place-color:#b9892d}.accent-blue{--place-color:#66888a}.accent-red{--place-color:#a94e39}.accent-green{--place-color:#70876d}.accent-clay{--place-color:#b87550}.accent-indigo{--place-color:#475b72}
  @media(max-width:900px){.place-grid{grid-template-columns:repeat(3,1fr)}}
  @media(max-width:700px){.places-intro>div,.heading{grid-template-columns:1fr;gap:30px}.destinations,.journeys{padding:75px 0}.place-grid,.journey-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.place-card>div{height:125px}.place-card h4{font-size:21px}.place-card>p{min-height:55px}.journey{padding:22px}.journey h3{font-size:29px}.journey footer{display:grid}.journey footer small{text-align:left}}
</style>
