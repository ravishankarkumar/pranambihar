---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';

const places = (await getCollection('places')).sort((a,b) => Number(b.data.featured) - Number(a.data.featured) || a.data.name.localeCompare(b.data.name));
const kinds = ['History & heritage','Nature','Sacred journey','City & culture'] as const;
---
<SiteLayout title="Places" description="Discover destinations across Bihar." eyebrow="Go beyond the map" heading="Places that stay with you." intro="Sacred paths, historic cities, river landscapes, forests and destinations worth seeing slowly and well.">
  <section class="places-intro"><div class="wrap"><p>Begin with a destination. When you are ready to connect several places into a day or weekend, our Escapes will shape the route.</p><div><strong>{places.length}</strong><span>places in the atlas</span></div></div></section>
  <section class="destinations wrap">
    <div class="heading"><div><p class="tag">Destination atlas</p><h2>Find your way<br/><em>into Bihar.</em></h2></div><p>Each entry is a starting point. Practical details and reported local recommendations will deepen as the atlas grows.</p></div>
    {kinds.map((kind,index) => { const entries=places.filter(place => place.data.kind === kind); if(!entries.length) return null; return <section class="place-group"><div class="group-title"><span>0{index+1}</span><h3>{kind}</h3><p>{entries.length} places</p></div><div class="place-grid">{entries.map(place => <a class={`place-card accent-${place.data.accent}`} href={`/places/${place.id}/`}><div><span>{place.data.district}</span><b>{place.data.name.slice(0,1)}</b></div><small>{place.data.duration} · {place.data.bestSeason}</small><h4>{place.data.name}</h4><p>{place.data.tagline}</p><i>Explore ↗</i></a>)}</div></section>; })}
  </section>
  <section class="escape-bridge"><div class="wrap"><div><p class="tag">Ready to go?</p><h2>Turn places into<br/><em>an escape.</em></h2></div><div><p>Choose from day trips, slow weekends and road-ready routes that connect Bihar’s destinations through landscape and story.</p><a href="/escapes/">Browse Bihar Escapes <span>→</span></a></div></div></section>
</SiteLayout>
<style>
  .places-intro{background:#142c27;color:#f4eee2;padding:52px 0}.places-intro>div{display:grid;grid-template-columns:1.4fr 1fr;gap:60px;align-items:center}.places-intro p{font:22px/1.5 Georgia;margin:0}.places-intro>div>div{display:flex;gap:12px;align-items:end}.places-intro strong{font:48px Georgia;color:#e9a93a}.places-intro span{text-transform:uppercase;letter-spacing:.13em;font-size:9px;padding-bottom:10px}.destinations{padding:100px 0 120px}.heading{display:grid;grid-template-columns:1fr 390px;gap:60px;align-items:end;margin-bottom:55px}.heading h2{font:clamp(46px,5.5vw,76px)/.98 Georgia;margin:14px 0 0}.heading h2 em{font-weight:normal;color:#e0a33c}.heading>p{color:#69706b}.place-group{margin-top:65px}.group-title{display:grid;grid-template-columns:45px 1fr auto;align-items:end;border-bottom:1px solid rgba(20,44,39,.2);padding-bottom:15px;margin-bottom:18px}.group-title span,.group-title p{font-size:9px;text-transform:uppercase;letter-spacing:.12em;color:#a9432e;margin:0}.group-title h3{font:32px Georgia;margin:0}.place-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}.place-card{background:#fff;border:1px solid rgba(20,44,39,.14);padding-bottom:20px;min-width:0}.place-card>div{height:150px;background:var(--place-color);color:#fff;display:grid;place-items:center;position:relative;overflow:hidden}.place-card>div:before{content:'';position:absolute;width:100px;height:100px;border:1px solid currentColor;border-radius:50%;opacity:.28}.place-card>div span{position:absolute;left:13px;top:12px;font-size:8px;text-transform:uppercase;letter-spacing:.08em}.place-card>div b{font:36px Georgia;font-weight:normal;z-index:1}.place-card>small,.place-card h4,.place-card>p,.place-card>i{display:block;margin-left:18px;margin-right:18px}.place-card>small{font-size:7px;text-transform:uppercase;letter-spacing:.08em;color:#a9432e;margin-top:16px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.place-card h4{font:25px/1.05 Georgia;margin-top:8px;margin-bottom:7px}.place-card>p{font-size:12px;color:#69706b;min-height:38px}.place-card>i{font-style:normal;font-size:9px;text-transform:uppercase;letter-spacing:.1em}.escape-bridge{padding:100px 0;background:#e6d8c1}.escape-bridge>div{display:grid;grid-template-columns:1fr 1fr;gap:100px;align-items:end}.escape-bridge h2{font:clamp(46px,5.5vw,76px)/.98 Georgia;margin:14px 0 0}.escape-bridge h2 em{font-weight:normal;color:#a9432e}.escape-bridge>div>div:last-child p{color:#69706b}.escape-bridge a{display:inline-flex;justify-content:space-between;gap:35px;border-bottom:1px solid;padding-bottom:5px;text-transform:uppercase;font-size:10px;font-weight:bold;letter-spacing:.1em}.accent-gold{--place-color:#b9892d}.accent-blue{--place-color:#66888a}.accent-red{--place-color:#a94e39}.accent-green{--place-color:#70876d}.accent-clay{--place-color:#b87550}.accent-indigo{--place-color:#475b72}
  @media(max-width:900px){.place-grid{grid-template-columns:repeat(3,1fr)}}
  @media(max-width:700px){.places-intro>div,.heading,.escape-bridge>div{grid-template-columns:1fr;gap:30px}.destinations,.escape-bridge{padding:75px 0}.place-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.place-card>div{height:125px}.place-card h4{font-size:21px}.place-card>p{min-height:55px}}
</style>
