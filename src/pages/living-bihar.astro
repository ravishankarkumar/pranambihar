---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';

const entries = await getCollection('culture');
const festivals = entries.filter(entry => entry.data.section === 'festivals');
const languages = entries.filter(entry => entry.data.section === 'languages');
const traditions = entries.filter(entry => entry.data.section === 'traditions');
const fading = entries.filter(entry => entry.data.section === 'before-it-fades');
const entryUrl = (entry: typeof entries[number]) => `/living-bihar/${entry.data.section}/${entry.id}/`;
---
<SiteLayout title="Living Bihar" description="Festivals, languages, rituals and traditions that shape everyday life in Bihar." eyebrow="Culture in motion" heading="Bihar is lived, not displayed." intro="Festivals, voices, rituals and changing traditions—understood through the people who carry them forward.">
  <section class="living-intro"><div class="wrap"><blockquote>Culture is not a cabinet of old things. It changes each time a song is sung, a language is spoken or a family prepares for a festival.</blockquote><a href="/people/">Meet the people who carry it →</a></div></section>
  <nav class="section-nav wrap" aria-label="Living Bihar sections"><a href="/living-bihar/festivals/"><span>01</span>Festivals</a><a href="/living-bihar/languages/"><span>02</span>Languages</a><a href="/living-bihar/traditions/"><span>03</span>Traditions</a><a href="/living-bihar/before-it-fades/"><span>04</span>Before It Fades</a></nav>

  <section class="festival-section wrap">
    <div class="heading"><div><p class="tag">The year in motion</p><h2>Festivals with<br/><em>a before and after.</em></h2></div><p>We will follow preparation, food, music, work and public space—not only the most photographed moment.</p></div>
    <div class="festival-grid">{festivals.map((entry,index) => <a class={`festival-card accent-${entry.data.accent}`} href={entryUrl(entry)}><div><span>{entry.data.localName || String(index+1).padStart(2,'0')}</span></div><small>{entry.data.season} · {entry.data.region}</small><h3>{entry.data.title}</h3><p>{entry.data.summary}</p><i>Enter the story ↗</i></a>)}</div><a class="section-link" href="/living-bihar/festivals/">Explore all festivals →</a>
  </section>

  <section class="languages"><div class="wrap"><div class="heading"><div><p class="tag">Languages of home</p><h2>Not dialects<br/><em>of silence.</em></h2></div><p>Languages carry humour, intimacy, literature and ways of seeing. Each deserves speakers—not labels—at the centre.</p></div><div class="language-grid">{languages.map(entry => <a class={`language-card accent-${entry.data.accent}`} href={entryUrl(entry)}><span>{entry.data.localName || entry.data.title.slice(0,1)}</span><div><p>{entry.data.region}</p><h3>{entry.data.title}</h3><small>{entry.data.summary}</small></div><i>↗</i></a>)}</div><a class="section-link" href="/living-bihar/languages/">Explore Bihar’s languages →</a></div></section>

  <section class="traditions wrap"><div class="heading"><div><p class="tag">Knowledge in the hands</p><h2>Traditions are<br/><em>things people do.</em></h2></div><p>Cooking methods, songs, craft and household knowledge stay alive through practice—not display.</p></div><div class="fading-list">{traditions.map((entry,index) => <a href={entryUrl(entry)}><span>{String(index+1).padStart(2,'0')}</span><h3>{entry.data.title}</h3><p>{entry.data.summary}</p><i>↗</i></a>)}</div><a class="section-link" href="/living-bihar/traditions/">Explore living traditions →</a></section>

  <section class="fading wrap">
    <div class="heading"><div><p class="tag">Before it fades</p><h2>Document change<br/><em>while it is living.</em></h2></div><p>Neither nostalgia nor obituary: reported records of practices, places and working lives changing in front of us.</p></div>
    <div class="fading-list">{fading.map((entry,index) => <a href={entryUrl(entry)}><span>{String(index+1).padStart(2,'0')}</span><h3>{entry.data.title}</h3><p>{entry.data.summary}</p><i>↗</i></a>)}</div><a class="section-link" href="/living-bihar/before-it-fades/">Explore Before It Fades →</a>
  </section>

  <section class="people-bridge"><div class="wrap"><p class="tag">Culture has names and faces</p><h2>The tradition is shared.<br/><em>The story is personal.</em></h2><p>Artists, cooks, singers, craftspeople, organisers and keepers of memory belong in our People archive as individuals—not as anonymous representatives of culture.</p><a href="/people/">Explore People →</a></div></section>
</SiteLayout>
<style>
  .living-intro{padding:75px 0;background:#142c27;color:#f4eee2}.living-intro>div{display:grid;grid-template-columns:1.5fr .5fr;gap:80px;align-items:end}.living-intro blockquote{font:clamp(27px,3.4vw,43px)/1.25 Georgia;margin:0}.living-intro a{font-size:9px;text-transform:uppercase;letter-spacing:.1em;border-bottom:1px solid}.section-nav{display:grid;grid-template-columns:repeat(4,1fr);margin-top:40px;border:1px solid rgba(20,44,39,.16)}.section-nav a{padding:18px;border-right:1px solid rgba(20,44,39,.16);font:19px Georgia}.section-nav a:last-child{border-right:0}.section-nav span{display:block;font:8px Arial;color:#a9432e;margin-bottom:8px}.festival-section,.fading,.traditions{padding:105px 0}.heading{display:grid;grid-template-columns:1fr 390px;gap:60px;align-items:end;margin-bottom:50px}.heading h2,.people-bridge h2{font:clamp(46px,5.5vw,76px)/.98 Georgia;margin:14px 0 0}.heading h2 em,.people-bridge h2 em{font-weight:normal;color:#e0a33c}.heading>p{color:#69706b}.festival-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.festival-card{border:1px solid rgba(20,44,39,.14);background:#fff;padding-bottom:24px}.festival-card>div{height:180px;display:grid;place-items:center;background:var(--culture-color);color:#fff;position:relative;overflow:hidden}.festival-card>div:before,.festival-card>div:after{content:'';position:absolute;border:1px solid currentColor;border-radius:50%;width:130px;height:130px;opacity:.27}.festival-card>div:after{width:80px;height:80px}.festival-card>div span{font:30px Georgia;z-index:1}.festival-card>small,.festival-card h3,.festival-card>p,.festival-card>i{display:block;margin-left:22px;margin-right:22px}.festival-card>small{font-size:7px;text-transform:uppercase;letter-spacing:.08em;color:#a9432e;margin-top:18px}.festival-card h3{font:28px/1.05 Georgia;margin-top:7px;margin-bottom:10px}.festival-card>p{font-size:12px;color:#69706b;min-height:74px}.festival-card>i{font-style:normal;font-size:9px;text-transform:uppercase;letter-spacing:.09em}.languages{padding:100px 0;background:#e6d8c1}.language-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.language-card{background:#fbf8f1;padding:27px;display:grid;grid-template-columns:60px 1fr 15px;gap:18px;align-items:center;border-top:5px solid var(--culture-color)}.language-card>span{width:58px;height:58px;border-radius:50%;display:grid;place-items:center;background:var(--culture-color);color:#fff;font:22px Georgia}.language-card p{font-size:8px;text-transform:uppercase;letter-spacing:.08em;color:#a9432e;margin:0}.language-card h3{font:28px Georgia;margin:3px 0 9px}.language-card small{font-size:11px;color:#69706b}.language-card>i{font-style:normal}.fading-list{display:grid}.fading-list a{display:grid;grid-template-columns:50px .8fr 1.2fr 20px;gap:28px;align-items:center;padding:26px 0;border-top:1px solid rgba(20,44,39,.18)}.fading-list a:last-child{border-bottom:1px solid rgba(20,44,39,.18)}.fading-list span{font-size:9px;color:#a9432e}.fading-list h3{font:28px Georgia;margin:0}.fading-list p{font-size:12px;color:#69706b;margin:0}.fading-list i{font-style:normal}.section-link{display:inline-block;margin-top:28px;border-bottom:1px solid;font-size:9px;text-transform:uppercase;letter-spacing:.1em}.traditions{padding-top:105px;padding-bottom:0}.people-bridge{padding:105px 0;background:#a9432e;color:#f4eee2}.people-bridge>div{max-width:900px}.people-bridge h2 em{color:#f2bd5c}.people-bridge>div>p:not(.tag){max-width:650px;color:rgba(255,255,255,.72)}.people-bridge a{display:inline-block;margin-top:20px;border-bottom:1px solid;font-size:10px;text-transform:uppercase;letter-spacing:.1em}.accent-gold{--culture-color:#b9892d}.accent-blue{--culture-color:#66888a}.accent-red{--culture-color:#a94e39}.accent-green{--culture-color:#70876d}.accent-clay{--culture-color:#b87550}.accent-indigo{--culture-color:#475b72}
  @media(max-width:800px){.living-intro>div,.heading{grid-template-columns:1fr;gap:30px}.section-nav{grid-template-columns:1fr 1fr}.section-nav a:nth-child(2){border-right:0}.section-nav a:nth-child(-n+2){border-bottom:1px solid rgba(20,44,39,.16)}.festival-grid,.language-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.festival-section,.languages,.fading,.traditions,.people-bridge{padding:75px 0}.traditions{padding-bottom:0}.fading-list a{grid-template-columns:35px 1fr 20px}.fading-list p{grid-column:2}.festival-card>p{min-height:96px}}
</style>
