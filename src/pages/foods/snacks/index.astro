---
import { getCollection } from 'astro:content';
import SiteLayout from '../../../layouts/SiteLayout.astro';

const snacks = (await getCollection('snacks')).sort((a,b) => Number(b.data.featured) - Number(a.data.featured) || a.data.title.localeCompare(b.data.title));
const chai = snacks.find(snack => snack.id === 'chai');
const foodSnacks = snacks.filter(snack => snack.id !== 'chai');
const groups = [
  { type: 'Pairing', eyebrow: 'Sweet, salty, soft, crisp', title: 'Foods that make sense together.' },
  { type: 'Roasted snack', eyebrow: 'Jar, packet & handful', title: 'Simple snacks that travel.' },
  { type: 'Street snack', eyebrow: 'Hot from the stall', title: 'The evening begins here.' },
] as const;
---
<SiteLayout title="Snacks" description="Explore Bihar’s snack culture through chai, sweet-and-salty pairings, roasted grains and street-side favourites." eyebrow="Food · Snacks" heading="A little hunger. A lot of Bihar." intro="Bihar’s snacks are not a miscellaneous list between meals. They are combinations, contrasts and pauses—usually made complete by chai and company." compactHero={true}>
  <nav class="crumb wrap" aria-label="Breadcrumb"><a href="/foods/">Food</a><span>→</span><b>Snacks</b></nav>

  {chai && <section class="chai"><div class="wrap chai-grid"><div class="chai-mark"><span>चाय</span></div><div><p class="tag">The essential companion</p><h2>No snack story<br/><em>without chai.</em></h2></div><div><p>{chai.data.summary}</p><a href={`/foods/snacks/${chai.id}/`}>Pour another cup →</a></div></div></section>}

  <section class="snack-intro wrap"><div><span>{foodSnacks.length}</span><small>snacks and pairings</small></div><p>The same foods can carry different meanings. Murhi–batasha may be an everyday snack in one moment and Diwali Prasad in another; chura–safed buniya can be eaten at home or carried from a religious journey. Context belongs to the food.</p></section>

  {groups.map((group,groupIndex) => {
    const items = foodSnacks.filter(snack => snack.data.type === group.type);
    return <section class:list={['snack-group', { tint: groupIndex % 2 === 1 }]}><div class="wrap"><header><div><p class="tag">{group.eyebrow}</p><h2>{group.title}</h2></div><p>{items.length} {items.length === 1 ? 'entry' : 'entries'} in the growing snack atlas</p></header><div class="snack-grid">{items.map((snack,index) => <a class={`snack-card accent-${snack.data.accent}`} href={`/foods/snacks/${snack.id}/`}><div class="visual"><span>{snack.data.localName || String(index+1).padStart(2,'0')}</span></div><div class="copy"><small>{snack.data.moment}</small><h3>{snack.data.title}</h3><p>{snack.data.summary}</p><footer><span>{snack.data.region}</span><i>Explore ↗</i></footer></div></a>)}</div></div></section>;
  })}

  <section class="closing"><div class="wrap"><p class="tag">Not a fixed menu</p><h2>The snack changes<br/><em>with the company.</em></h2><p>Names, proportions and combinations shift between homes, stalls and districts. This atlas keeps those differences visible instead of choosing one version for all of Bihar.</p></div></section>
</SiteLayout>
<style>
  .crumb{display:flex;gap:12px;padding-top:18px;font-size:9px;text-transform:uppercase;letter-spacing:.1em;color:#69706b}.crumb a{border-bottom:1px solid}.crumb b{color:#142c27}.chai{margin-top:40px;padding:75px 0;background:#142c27;color:#f4eee2}.chai-grid{display:grid;grid-template-columns:220px 1fr 1fr;gap:55px;align-items:center}.chai-mark{aspect-ratio:1;border-radius:50%;display:grid;place-items:center;border:1px solid rgba(255,255,255,.32);position:relative}.chai-mark:after{content:'';position:absolute;width:65%;aspect-ratio:1;border:1px solid rgba(255,255,255,.22);border-radius:50%}.chai-mark span{font:46px Georgia;color:#e9a93a;z-index:1}.chai h2{font:clamp(42px,5vw,66px)/.97 Georgia;margin:12px 0}.chai h2 em,.closing h2 em{color:#e9a93a;font-weight:normal}.chai-grid>div:last-child p{font:18px/1.65 Georgia;color:rgba(255,255,255,.72)}.chai a{display:inline-block;margin-top:15px;border-bottom:1px solid;font-size:9px;text-transform:uppercase;letter-spacing:.12em}.snack-intro{display:grid;grid-template-columns:260px 1fr;gap:80px;padding-top:70px;padding-bottom:70px}.snack-intro>div{display:flex;gap:16px;align-items:center}.snack-intro span{font:64px Georgia;color:#a9432e}.snack-intro small{max-width:100px;text-transform:uppercase;letter-spacing:.11em}.snack-intro>p{font:21px/1.6 Georgia;margin:0}.snack-group{padding:85px 0}.snack-group.tint{background:#f0eadd}.snack-group header{display:grid;grid-template-columns:1fr 260px;gap:60px;align-items:end;margin-bottom:38px}.snack-group h2{font:clamp(38px,4vw,55px)/1 Georgia;margin:12px 0 0}.snack-group header>p{font-size:10px;text-transform:uppercase;letter-spacing:.1em;color:#69706b}.snack-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}.snack-card{background:#fff;border:1px solid rgba(20,44,39,.14);min-width:0}.visual{height:150px;background:var(--snack-color);color:#fff;display:grid;place-items:center;position:relative;overflow:hidden}.visual:before,.visual:after{content:'';position:absolute;width:115px;height:115px;border:1px solid currentColor;border-radius:50%;opacity:.25}.visual:after{width:72px;height:72px}.visual span{font:23px Georgia;z-index:1;text-align:center;padding:15px}.copy{padding:20px}.copy small{display:block;color:#a9432e;font-size:7px;text-transform:uppercase;letter-spacing:.08em;min-height:25px}.copy h3{font:25px/1.08 Georgia;margin:8px 0 13px}.copy>p{font-size:11px;color:#69706b;min-height:105px}.copy footer{padding-top:13px;border-top:1px solid rgba(20,44,39,.14);display:grid;grid-template-columns:1fr auto;gap:12px;font-size:7px;text-transform:uppercase;letter-spacing:.06em}.copy footer i{font-style:normal;white-space:nowrap}.closing{background:#e6d8c1;padding:90px 0}.closing h2{font:clamp(45px,6vw,76px)/1 Georgia;margin:14px 0 22px}.closing>div>p:last-child{max-width:650px;color:#5f6864}.accent-gold{--snack-color:#b9892d}.accent-blue{--snack-color:#66888a}.accent-red{--snack-color:#a94e39}.accent-green{--snack-color:#70876d}.accent-clay{--snack-color:#b87550}.accent-indigo{--snack-color:#475b72}@media(max-width:900px){.chai-grid{grid-template-columns:150px 1fr}.chai-grid>div:last-child{grid-column:2}.snack-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:620px){.chai{padding:55px 0}.chai-grid,.snack-intro,.snack-group header{grid-template-columns:1fr;gap:25px}.chai-mark{width:130px}.chai-grid>div:last-child{grid-column:auto}.snack-intro{padding-top:50px;padding-bottom:50px}.snack-grid{grid-template-columns:1fr}.copy>p{min-height:0}.snack-group{padding:65px 0}}
</style>
