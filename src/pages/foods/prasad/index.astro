---
import { getCollection } from 'astro:content';
import SiteLayout from '../../../layouts/SiteLayout.astro';

const prasads = (await getCollection('prasads')).sort((a, b) =>
  Number(b.data.featured) - Number(a.data.featured) || a.data.title.localeCompare(b.data.title)
);
const documented = prasads.filter(prasad => prasad.data.status === 'Documented starting point');
const regionalTraditions = prasads.filter(prasad => prasad.data.status === 'Regional and household tradition');
---
<SiteLayout
  title="Prasad of Bihar"
  description="A growing atlas of the foods Bihar prepares, offers and shares during festivals, pujas and community observances."
  eyebrow="Food, faith & memory"
  heading="Prepared with devotion."
  intro="Bihar has a rich culture of preparing distinctive prasad during festivals and pujas. These foods carry rules, seasons, vessels, family knowledge and the memory of sharing."
  compactHero={true}
>
  <nav class="crumb wrap" aria-label="Breadcrumb"><a href="/foods/">Food</a><span>→</span><b>Prasad</b></nav>

  <section class="introduction wrap">
    <p class="tag">{prasads.length} traditions and growing</p>
    <div><p>Prasad is not simply a recipe category. The same ingredient can mean something different when it is prepared for an observance, offered, and distributed within a community.</p><p>This is a selective beginning—not a claim to catalogue every tradition in Bihar.</p></div>
  </section>

  <section class="collection wrap">
    <div class="section-heading"><div><p class="tag">Published references</p><h2>Offerings with<br/><em>living context.</em></h2></div><p>These traditions are supported by published starting references and enriched by regional and household knowledge.</p></div>
    <div class="prasad-grid">{documented.map((prasad, index) => <article class={`prasad-card accent-${prasad.data.accent}`}>
      <div class="card-top"><span>{String(index + 1).padStart(2, '0')}</span><small>{prasad.data.observance}</small></div>
      <h3>{prasad.data.title}</h3>
      <p>{prasad.data.summary}</p>
      <div class="items">{prasad.data.items.map(item => <span>{item}</span>)}</div>
      <div class="card-meta"><span>{prasad.data.season}</span><i>{prasad.data.region}</i></div>
      <nav aria-label={`Related links for ${prasad.data.title}`}>
        {prasad.data.relatedFoods.map(id => <a href={`/foods/${id}/`}>Food ↗</a>)}
        {prasad.data.relatedCulture.map(id => <a href={`/culture/festivals/${id}/`}>Culture ↗</a>)}
        {prasad.data.sources.slice(0,1).map(source => <a href={source.url} target="_blank" rel="noreferrer">Source ↗</a>)}
      </nav>
    </article>)}</div>
  </section>

  <section class="community"><div class="wrap">
    <div class="community-heading"><div><p class="tag">Regional & household traditions</p><h2>Knowledge carried<br/>through practice.</h2></div><p>These traditions are recorded from lived Bihar experience. Their ingredients, names and rituals can vary between districts, shrines and families without making one version less valid.</p></div>
    <div class="community-grid">{regionalTraditions.map((prasad, index) => <article class={`note-card accent-${prasad.data.accent}`}>
      <span>{String(documented.length + index + 1).padStart(2, '0')}</span>
      <small>{prasad.data.observance}</small>
      <h3>{prasad.data.title}</h3>
      <p>{prasad.data.summary}</p>
      <div>{prasad.data.items.map(item => <b>{item}</b>)}</div>
      <i>{prasad.data.status}</i>
    </article>)}</div>
  </div></section>

  <section class="editorial"><div class="wrap"><p class="tag">How this collection will grow</p><div class="editorial-grid"><article><span>01</span><h3>Name the observance</h3><p>Record the festival, puja, vow or community occasion—not only the food.</p></article><article><span>02</span><h3>Respect local variation</h3><p>Document names, ingredients, vessels and methods without declaring one universal version.</p></article><article><span>03</span><h3>Credit the knowledge holder</h3><p>Place cooks, families, priests, growers and community custodians at the centre of the account.</p></article></div></div></section>
</SiteLayout>

<style>
  .crumb{display:flex;gap:12px;padding-top:18px;font-size:9px;text-transform:uppercase;letter-spacing:.1em;color:#69706b}.crumb a{border-bottom:1px solid}.crumb b{color:#142c27}.introduction{display:grid;grid-template-columns:1fr 1fr;gap:80px;padding-top:55px;padding-bottom:75px;border-bottom:1px solid rgba(20,44,39,.16)}.introduction>div{font:18px/1.55 Georgia;color:#53605b}.introduction>div p{margin:0 0 12px}.tag{text-transform:uppercase;letter-spacing:.18em;color:#a9432e;font-size:10px;font-weight:bold}.collection{padding-top:90px;padding-bottom:115px}.section-heading,.community-heading{display:grid;grid-template-columns:1fr 390px;gap:60px;align-items:end;margin-bottom:48px}.section-heading h2,.community-heading h2{font:clamp(44px,5.5vw,72px)/.98 Georgia;margin:14px 0 0}.section-heading h2 em{color:#e0a33c;font-weight:normal}.section-heading>p,.community-heading>p{color:#69706b;margin:0}.prasad-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.prasad-card{border-top:6px solid var(--prasad-color);background:#fff;padding:27px;min-height:470px;display:flex;flex-direction:column}.card-top{display:flex;justify-content:space-between;gap:20px}.card-top>span{font:30px Georgia;color:var(--prasad-color)}.card-top small{text-align:right;color:#a9432e;text-transform:uppercase;letter-spacing:.08em;font-size:8px;max-width:145px}.prasad-card h3{font:31px/1.06 Georgia;margin:38px 0 14px}.prasad-card>p{font-size:12px;color:#69706b}.items{display:flex;gap:7px;flex-wrap:wrap;margin:18px 0 28px}.items span{border:1px solid rgba(20,44,39,.18);border-radius:20px;padding:5px 9px;font-size:8px;text-transform:uppercase;letter-spacing:.06em}.card-meta{margin-top:auto;border-top:1px solid rgba(20,44,39,.14);padding-top:14px;display:grid;grid-template-columns:1fr 1fr;gap:14px;font-size:8px;text-transform:uppercase;letter-spacing:.07em}.card-meta i{font-style:normal;text-align:right;color:#69706b}.prasad-card nav{display:flex;gap:12px;flex-wrap:wrap;margin-top:18px}.prasad-card nav a{font-size:8px;text-transform:uppercase;letter-spacing:.08em;border-bottom:1px solid}.community{background:#142c27;color:#f4eee2;padding:95px 0 110px}.community-heading>p{color:rgba(255,255,255,.62)}.community-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1px;background:rgba(255,255,255,.15)}.note-card{padding:28px;background:#142c27;min-height:350px;display:flex;flex-direction:column}.note-card>span{color:#e9a93a;font-size:9px}.note-card>small{margin-top:30px;color:rgba(255,255,255,.6);text-transform:uppercase;letter-spacing:.09em;font-size:8px}.note-card h3{font:28px/1.06 Georgia;margin:9px 0 15px}.note-card>p{font-size:11px;color:rgba(255,255,255,.64)}.note-card>div{display:flex;flex-wrap:wrap;gap:7px;margin:15px 0 25px}.note-card b{font-size:8px;text-transform:uppercase;letter-spacing:.07em;border-bottom:1px solid rgba(255,255,255,.3);font-weight:normal}.note-card>i{font-style:normal;margin-top:auto;padding-top:14px;border-top:1px solid rgba(255,255,255,.15);color:#e9a93a;font-size:8px;text-transform:uppercase;letter-spacing:.08em}.editorial{background:#e6d8c1;padding:95px 0}.editorial-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:45px;margin-top:35px;border-top:1px solid rgba(20,44,39,.18);padding-top:28px}.editorial-grid span{font-size:9px;color:#a9432e}.editorial-grid h3{font:27px Georgia;margin:30px 0 10px}.editorial-grid p{font-size:12px;color:#69706b;max-width:280px}.accent-gold{--prasad-color:#b9892d}.accent-blue{--prasad-color:#66888a}.accent-red{--prasad-color:#a94e39}.accent-green{--prasad-color:#70876d}.accent-clay{--prasad-color:#b87550}.accent-indigo{--prasad-color:#475b72}@media(max-width:1000px){.prasad-grid,.community-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:700px){.introduction,.section-heading,.community-heading{grid-template-columns:1fr;gap:25px}.introduction{padding:45px 0 55px}.collection,.community,.editorial{padding:70px 0}.prasad-grid,.community-grid,.editorial-grid{grid-template-columns:1fr}.prasad-card,.note-card{min-height:0}.editorial-grid{gap:18px}.editorial-grid article{border-bottom:1px solid rgba(20,44,39,.15);padding-bottom:18px}}
</style>
