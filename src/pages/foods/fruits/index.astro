---
import { getCollection } from 'astro:content';
import SiteLayout from '../../../layouts/SiteLayout.astro';

const fruits = (await getCollection('fruits')).sort((a,b) => Number(b.data.featured) - Number(a.data.featured) || a.data.name.localeCompare(b.data.name));
const featured = fruits.filter(fruit => fruit.data.featured);
const everyday = fruits.filter(fruit => !fruit.data.featured);
---
<SiteLayout title="Fruits of Bihar" description="A seasonal atlas of Bihar’s mangoes, litchis, bananas, guavas and the people and places behind them." eyebrow="Food · Fruit & orchard" heading="A season you can taste." intro="Bihar’s fruits belong to orchards, market arrivals, childhood anticipation and regional pride. This collection follows varieties—not merely generic names—and the people who grow and carry them." compactHero={true}>
  <nav class="crumb wrap" aria-label="Breadcrumb"><a href="/foods/">Food</a><span>→</span><b>Fruits</b></nav>

  <section class="featured wrap"><header><div><p class="tag">Place in every bite</p><h2>Bihar’s named<br/><em>fruit identities.</em></h2></div><p>Geographical recognition is a starting point. The fuller story includes orchard knowledge, a short harvest window and the journey from grower to market.</p></header><div class="feature-grid">{featured.map((fruit,index) => <a class={`fruit-card large accent-${fruit.data.accent}`} href={`/foods/fruits/${fruit.id}/`}><div><span>{fruit.data.localName}</span><i>0{index+1}</i></div><small>{fruit.data.identity}</small><h3>{fruit.data.name}</h3><p>{fruit.data.summary}</p><footer><span>{fruit.data.season}</span><i>Explore ↗</i></footer></a>)}</div></section>

  <section class="everyday"><div class="wrap"><header><div><p class="tag">Beyond the headline fruit</p><h2>The everyday<br/><em>fruit basket.</em></h2></div><p>This atlas will grow through varieties, seasons, markets and local preference—not a catalogue copied from elsewhere.</p></header><div class="feature-grid compact">{everyday.map((fruit,index) => <a class={`fruit-card accent-${fruit.data.accent}`} href={`/foods/fruits/${fruit.id}/`}><div><span>{fruit.data.localName}</span><i>0{index+1}</i></div><small>{fruit.data.identity}</small><h3>{fruit.data.name}</h3><p>{fruit.data.summary}</p><footer><span>{fruit.data.region}</span><i>Explore ↗</i></footer></a>)}</div></div></section>

  <section class="season-note"><div class="wrap"><p class="tag">Follow the season</p><h2>Not always available.<br/><em>Worth waiting for.</em></h2><p>A fruit’s season is part of its identity. Future entries will record the weeks people wait for, the varieties they distinguish and the places whose names travel with the harvest.</p></div></section>
</SiteLayout>
<style>
  .crumb{display:flex;gap:12px;padding-top:18px;font-size:9px;text-transform:uppercase;letter-spacing:.1em;color:#69706b}.crumb a{border-bottom:1px solid}.crumb b{color:#142c27}.featured,.everyday>.wrap{padding-top:80px;padding-bottom:100px}.featured header,.everyday header{display:grid;grid-template-columns:1fr 380px;gap:70px;align-items:end;margin-bottom:40px}.featured h2,.everyday h2,.season-note h2{font:clamp(46px,5.5vw,76px)/.98 Georgia;margin:12px 0 0}.featured h2 em,.everyday h2 em,.season-note h2 em{font-weight:normal;color:#e0a33c}.featured header>p,.everyday header>p{color:#69706b}.feature-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px}.fruit-card{background:#fff;border:1px solid rgba(20,44,39,.14);padding-bottom:24px}.fruit-card>div{height:220px;background:var(--fruit-color);color:#fff;display:grid;place-items:center;position:relative;overflow:hidden}.fruit-card>div:before,.fruit-card>div:after{content:'';position:absolute;border:1px solid currentColor;border-radius:50%;width:170px;height:170px;opacity:.25}.fruit-card>div:after{width:105px;height:105px}.fruit-card>div span{font:33px Georgia;z-index:1}.fruit-card>div i{position:absolute;right:16px;bottom:13px;font:italic 11px Georgia}.fruit-card>small,.fruit-card h3,.fruit-card>p,.fruit-card footer{display:block;margin-left:24px;margin-right:24px}.fruit-card>small{margin-top:20px;color:#a9432e;font-size:8px;text-transform:uppercase;letter-spacing:.1em}.fruit-card h3{font:34px Georgia;margin-top:8px;margin-bottom:10px}.fruit-card>p{color:#69706b;min-height:58px;font-size:13px}.fruit-card footer{border-top:1px solid rgba(20,44,39,.14);padding-top:14px;display:grid;grid-template-columns:1fr auto;gap:15px;font-size:8px;text-transform:uppercase;letter-spacing:.07em}.fruit-card footer i{font-style:normal}.everyday{background:#f0eadd}.compact .fruit-card>div{height:165px}.season-note{padding:95px 0;background:#142c27;color:#f4eee2}.season-note>div>p:last-child{max-width:650px;color:rgba(255,255,255,.65)}.accent-gold{--fruit-color:#b9892d}.accent-blue{--fruit-color:#66888a}.accent-red{--fruit-color:#a94e39}.accent-green{--fruit-color:#70876d}.accent-clay{--fruit-color:#b87550}.accent-indigo{--fruit-color:#475b72}@media(max-width:700px){.featured,.everyday>.wrap{padding-top:65px;padding-bottom:75px}.featured header,.everyday header{grid-template-columns:1fr;gap:22px}.feature-grid{grid-template-columns:1fr}.fruit-card>div{height:170px}.fruit-card>p{min-height:0}}
</style>
