---
import { getCollection } from 'astro:content';
import FoodCard from '../../components/FoodCard.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';

const foods = await getCollection('foods');
const combinations = (await getCollection('foodCombinations')).sort((a,b) => Number(b.data.featured) - Number(a.data.featured));
const flagshipIds = ['litti-chokha','champaran-meat','dal-pitha','thekua','silao-khaja','gaya-tilkut'];
const flagships = flagshipIds.map(id => foods.find(food => food.id === id)).filter(food => food !== undefined);
const categories = ['Main dishes','Everyday table','Breads & snacks','Drinks','Sweets & festival foods'] as const;
const extendedFoods = foods.filter(food => !flagshipIds.includes(food.id));
const foodStory = (await getCollection('stories')).find(story => story.id === 'makhana-country');
const sweetGroups = [
  { title: 'Named for a place', note: 'Sweets whose identity travels with a town or region.', ids: ['silao-khaja','gaya-tilkut','maner-laddoo','barh-lai'] },
  { title: 'Festival table', note: 'Preparations tied to offerings, seasons and celebration.', ids: ['thekua','anarsa','malpua','makhana-kheer'] },
  { title: 'The halwai case', note: 'Layered, filled and syrup-finished sweets found across Bihar.', ids: ['balushahi','chandrakala','parwal-mithai'] },
];
const ritualFoods = [
  ['Puja prasad','Offerings vary by observance, household and region—and should be documented with the people who prepare them.'],
  ['Earthen-pot kheer','A preparation connected in some communities with Bhuiya Baba worship and the character of clay-pot cooking.'],
  ['Batasha, murhi and chura','Simple combinations that hold ritual, seasonal and household meaning beyond their ingredients.'],
  ['Food roasted over goitha','Guava, raw mango and other produce cooked over a traditional fire: technique, memory and flavour together.'],
];
---
<SiteLayout title="Food" description="Explore Bihar’s food through dishes, ingredients, seasons, regions and the people who sustain them." eyebrow="Food & Land" heading="A table with many stories." intro="Bihar does not have one cuisine. Explore dishes through their regions, seasons, techniques and living household variations.">
  <section class="food-intro"><div class="wrap intro-grid"><p>From the smoke held inside litti to the fine layers of Silao khaja, food in Bihar is a record of climate, movement, celebration and skilled hands.</p><div><span>{foods.length}</span><small>dishes in the growing atlas</small></div><a href={foodStory ? `/stories/${foodStory.id}/` : '/stories/'}>Read Makhana Country →</a></div></section>

  <section class="flagship wrap">
    <div class="section-title"><div><p class="tag">Begin here</p><h2>Flagships of<br/><em>Bihar’s table.</em></h2></div><p>Six widely recognised dishes and sweets—each an invitation into a much larger regional food culture.</p></div>
    <div class="flagship-grid">{flagships.map((food,index) => <FoodCard food={food} index={index}/>)}</div>
  </section>

  <section class="pairings">
    <div class="wrap section-title pairing-title"><div><p class="tag">Plates of Bihar</p><h2>Some foods are<br/><em>better together.</em></h2></div><p>These are not merely side dishes. Texture, heat, sourness and sweetness turn familiar preparations into a complete plate.</p></div>
    <div class="wrap pairing-grid">{combinations.map((combination,index) => <article class={`pairing-card accent-${combination.data.accent}`}><span>{String(index+1).padStart(2,'0')}</span><p>{combination.data.occasion}</p><h3>{combination.data.title}</h3><div>{combination.data.items.map((item,i) => <>{item.foodId ? <a href={`/foods/${item.foodId}/`}>{item.label}</a> : <b>{item.label}</b>}{i < combination.data.items.length-1 && <i>+</i>}</>)}</div><small>{combination.data.summary}</small></article>)}</div>
  </section>

  <section class="sweets-guide">
    <div class="wrap more-heading"><p class="tag">Sweets of Bihar</p><h2>One sweet map,<br/>many traditions.</h2><p>Explore sweets through place, festival and the craft of the halwai—not as one undifferentiated list.</p></div>
    <div class="wrap sweet-groups">{sweetGroups.map((group,index) => <article><span>0{index+1}</span><h3>{group.title}</h3><p>{group.note}</p><div>{group.ids.map(id => { const food=foods.find(item => item.id === id); return food && <a href={`/foods/${food.id}/`}>{food.data.name} ↗</a>; })}</div></article>)}</div>
  </section>

  <section class="more-foods">
    <div class="wrap more-heading"><p class="tag">Go beyond the familiar</p><h2>More from Bihar’s table.</h2><p>Everyday plates, street snacks, cooling drinks and place-specific sweets.</p></div>
    <nav class="category-nav wrap" aria-label="Food categories">{categories.map((category,i) => <a href={`#category-${i+1}`}>{category}</a>)}</nav>
    {categories.map((category,categoryIndex) => {
      const items = extendedFoods.filter(food => food.data.category === category).sort((a,b) => a.data.name.localeCompare(b.data.name));
      if (!items.length) return null;
      return <section class="compact-category" id={`category-${categoryIndex+1}`}><div class="wrap"><div class="category-title"><span>0{categoryIndex+1}</span><h3>{category}</h3><p>{items.length} entries</p></div><div class="compact-grid">{items.map(food => <a class={`compact-card accent-${food.data.accent}`} href={`/foods/${food.id}/`}><span class="compact-visual"><b>{food.data.localName?.slice(0,1) || 'ब'}</b></span><div class="compact-copy"><small>{food.data.region}</small><h4>{food.data.name}</h4><p>{food.data.season}</p></div><i>↗</i></a>)}</div></div></section>
    })}
  </section>

  <section class="ritual-foods"><div class="wrap"><div class="section-title"><div><p class="tag">Food, faith & memory</p><h2>More than<br/><em>a recipe.</em></h2></div><p>Some preparations make sense only when the occasion, vessel, fire and people around them are part of the story.</p></div><div class="ritual-grid">{ritualFoods.map((item,index) => <article><span>0{index+1}</span><h3>{item[0]}</h3><p>{item[1]}</p></article>)}</div><div class="produce"><p>Ingredients & produce to explore</p><div><span>Makhana</span><span>Muzaffarpur litchi</span><span>Hajipur banana</span><span>Singhara</span><span>Barhal</span><span>Bel</span></div></div></div></section>

  <section class="variation"><div class="wrap"><p class="tag">An evolving atlas</p><h2>One name can hold<br/><em>many family recipes.</em></h2><p>Descriptions here are starting points, not declarations of a single “authentic” version. As the atlas grows, we will document regional names, household methods and the people who carry this knowledge.</p></div></section>
</SiteLayout>
<style>
  .food-intro{padding:55px 0;background:#142c27;color:#f4eee2}.intro-grid{display:grid;grid-template-columns:1.4fr .7fr .8fr;gap:50px;align-items:center}.intro-grid>p{font:22px/1.5 Georgia;margin:0}.intro-grid>div{display:flex;gap:12px;align-items:center}.intro-grid>div span{font:50px Georgia;color:#e9a93a}.intro-grid small{text-transform:uppercase;letter-spacing:.1em;line-height:1.4}.intro-grid>a{font-size:10px;text-transform:uppercase;letter-spacing:.12em;border-bottom:1px solid;width:max-content}.flagship{padding:100px 0 125px}.section-title{display:grid;grid-template-columns:1fr 380px;gap:60px;align-items:end;margin-bottom:48px}.tag{text-transform:uppercase;letter-spacing:.18em;color:#a9432e;font-size:10px;font-weight:bold}.section-title h2,.more-heading h2{font:clamp(46px,5.5vw,76px)/.98 Georgia;margin:15px 0 0}.section-title h2 em{color:#e0a33c;font-weight:normal}.section-title>p,.more-heading>p:last-child{color:#69706b}.flagship-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}.more-foods{background:#f0eadd;padding:95px 0 110px}.more-heading{display:grid;grid-template-columns:1fr 1.3fr 1fr;gap:35px;align-items:end}.more-heading h2{font-size:53px}.more-heading p{margin:0}.category-nav{display:flex;gap:9px;padding-top:42px;padding-bottom:18px;overflow:auto}.category-nav a{white-space:nowrap;border:1px solid rgba(20,44,39,.23);border-radius:30px;padding:9px 14px;font-size:9px;text-transform:uppercase;letter-spacing:.1em;background:#f0eadd}.category-nav a:hover{background:#142c27;color:#f4eee2}.compact-category{padding:48px 0 10px}.category-title{display:grid;grid-template-columns:45px 1fr auto;align-items:end;border-bottom:1px solid rgba(20,44,39,.2);padding-bottom:17px;margin-bottom:18px}.category-title span{font-size:10px;color:#a9432e}.category-title h3{font:32px Georgia;margin:0}.category-title p{font-size:9px;text-transform:uppercase;letter-spacing:.12em;color:#69706b;margin:0}.compact-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.compact-card{display:grid;grid-template-columns:58px 1fr 20px;gap:17px;align-items:center;background:#fbf8f1;border:1px solid rgba(20,44,39,.12);padding:20px;transition:transform .2s,background .2s}.compact-card:hover{transform:translateX(5px);background:#fff}.glyph{width:52px;height:52px;border-radius:50%;display:grid;place-items:center;background:var(--mini-color);color:#fff;font:22px Georgia}.compact-card small{text-transform:uppercase;letter-spacing:.09em;font-size:8px;color:#a9432e}.compact-card h4{font:24px Georgia;margin:4px 0}.compact-card p{font-size:12px;line-height:1.45;color:#69706b;margin:0}.compact-card i{font-style:normal}.accent-gold{--mini-color:#b9892d}.accent-blue{--mini-color:#66888a}.accent-red{--mini-color:#a94e39}.accent-green{--mini-color:#70876d}.accent-clay{--mini-color:#b87550}.accent-indigo{--mini-color:#475b72}.variation{padding:100px 0;background:#e6d8c1}.variation h2{font:clamp(45px,6vw,76px)/1 Georgia;margin:18px 0 25px}.variation h2 em{color:#a9432e;font-weight:normal}.variation>div>p:last-child{max-width:610px;color:#5f6864}
  /* Dense, image-ready food atlas layout. */
  .flagship-grid{grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}
  .compact-grid{grid-template-columns:repeat(6,minmax(0,1fr));gap:12px}
  .compact-card{position:relative;display:block;min-width:0;padding:0;overflow:hidden;background:#fbf8f1;transition:transform .2s,box-shadow .2s}
  .compact-card:hover{transform:translateY(-4px);background:#fff;box-shadow:0 14px 28px rgba(20,44,39,.11)}
  .compact-visual{aspect-ratio:4/3;display:grid;place-items:center;position:relative;overflow:hidden;background:var(--mini-color);color:#fff}
  .compact-visual:before,.compact-visual:after{content:'';position:absolute;width:72%;aspect-ratio:1;border:1px solid currentColor;border-radius:50%;opacity:.28}
  .compact-visual:after{width:46%}
  .compact-visual b{font:29px Georgia;font-weight:normal;z-index:1}
  .compact-copy{padding:14px}
  .compact-card small{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:7px;letter-spacing:.08em}
  .compact-card h4{font:20px/1.05 Georgia;margin:6px 0 11px}
  .compact-card p{font-size:8px;text-transform:uppercase;letter-spacing:.06em;color:#69706b;margin:0;padding-right:15px}
  .compact-card i{position:absolute;right:10px;bottom:9px;font-size:11px}
  .pairings{padding:100px 0;background:#142c27;color:#f4eee2}.pairing-title{padding:0}.pairing-title>p{color:rgba(255,255,255,.62)}.pairing-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1px;background:rgba(255,255,255,.16)}.pairing-card{padding:25px;background:#142c27;min-height:280px;display:flex;flex-direction:column}.pairing-card>span{font-size:9px;color:#e9a93a}.pairing-card>p{font-size:8px;text-transform:uppercase;letter-spacing:.1em;color:rgba(255,255,255,.58);margin:28px 0 8px}.pairing-card h3{font:27px/1.05 Georgia;margin:0 0 22px}.pairing-card>div{display:flex;flex-wrap:wrap;gap:7px;align-items:center;margin-bottom:20px}.pairing-card a,.pairing-card b{font-size:9px;text-transform:uppercase;letter-spacing:.08em;border-bottom:1px solid rgba(255,255,255,.35)}.pairing-card b{font-weight:normal}.pairing-card i{font-style:normal;color:#e9a93a}.pairing-card small{color:rgba(255,255,255,.61);font-size:11px;line-height:1.55;margin-top:auto}.sweets-guide{padding:100px 0;background:#e6d8c1}.sweet-groups{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:48px}.sweet-groups article{background:#fbf8f1;padding:28px}.sweet-groups article>span{color:#a9432e;font-size:9px}.sweet-groups h3{font:30px Georgia;margin:30px 0 8px}.sweet-groups p{font-size:12px;color:#69706b;min-height:58px}.sweet-groups article>div{display:grid;border-top:1px solid rgba(20,44,39,.16)}.sweet-groups a{padding:10px 0;border-bottom:1px solid rgba(20,44,39,.16);font-size:10px;text-transform:uppercase;letter-spacing:.08em}.ritual-foods{padding:100px 0;background:#fbf8f1}.ritual-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:22px}.ritual-grid article{border-top:2px solid #142c27;padding-top:18px}.ritual-grid span{font-size:9px;color:#a9432e}.ritual-grid h3{font:25px Georgia;margin:35px 0 12px}.ritual-grid p{font-size:12px;color:#69706b}.produce{margin-top:75px;padding:30px;background:#f0eadd;display:grid;grid-template-columns:220px 1fr;gap:30px;align-items:center}.produce>p{font:22px Georgia;margin:0}.produce>div{display:flex;flex-wrap:wrap;gap:9px}.produce span{border:1px solid rgba(20,44,39,.2);border-radius:30px;padding:8px 13px;font-size:9px;text-transform:uppercase;letter-spacing:.08em}
  @media(max-width:1000px){.flagship-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.more-heading{grid-template-columns:1fr}.compact-grid{grid-template-columns:repeat(4,minmax(0,1fr))}}
  @media(max-width:1000px){.pairing-grid,.ritual-grid{grid-template-columns:repeat(2,1fr)}.sweet-groups{grid-template-columns:1fr 1fr}}
  @media(max-width:700px){.intro-grid,.section-title{grid-template-columns:1fr;gap:28px}.flagship{padding:75px 0 90px}.flagship-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.more-foods,.pairings,.sweets-guide,.ritual-foods{padding:70px 0}.more-heading h2{font-size:43px}.category-nav{margin-right:0}.category-title{grid-template-columns:32px 1fr}.category-title p{grid-column:2}.compact-grid,.pairing-grid,.sweet-groups,.ritual-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.pairing-card{padding:18px;min-height:260px}.sweet-groups article{padding:20px}.sweet-groups p{min-height:0}.compact-card h4{font-size:19px}.produce{grid-template-columns:1fr}.variation{padding:75px 0}}
</style>
