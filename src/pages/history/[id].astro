---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
export async function getStaticPaths(){const entries=await getCollection('history');return entries.map(entry=>({params:{id:entry.id},props:{entry}}));}
interface Props{entry:CollectionEntry<'history'>} const {entry}=Astro.props; const {Content}=await render(entry);
const places=await getCollection('places'); const people=await getCollection('people');
const relatedPlaces=entry.data.relatedPlaces.map(id=>places.find(item=>item.id===id)).filter(Boolean);
const relatedPeople=entry.data.relatedPeople.map(id=>people.find(item=>item.id===id)).filter(Boolean);
---
<SiteLayout title={entry.data.title} description={entry.data.summary} eyebrow={`${entry.data.period} · ${entry.data.dateLabel}`} heading={entry.data.title} intro={entry.data.summary} compactHero>
  <article class="history-profile"><nav class="crumb wrap"><a href="/history/">History</a><span>→</span><b>{entry.data.title}</b></nav><div class="facts wrap"><div><small>Period</small><strong>{entry.data.period}</strong></div><div><small>When</small><strong>{entry.data.dateLabel}</strong></div><div><small>Region</small><strong>{entry.data.region}</strong></div></div><div class="body wrap"><aside><span>Read with context</span><p>Dates organise the account; they do not replace explanation. Sources and interpretations will deepen as this chapter grows.</p></aside><div class="prose"><Content /></div></div>
  {(relatedPlaces.length>0||relatedPeople.length>0)&&<section class="connections wrap"><p class="tag">Continue through the archive</p><div>{relatedPlaces.map(place=>place&&<a href={`/places/${place.id}/`}><small>Place</small><strong>{place.data.name}</strong><span>↗</span></a>)}{relatedPeople.map(person=>person&&<a href={`/people/${person.id}/`}><small>Person</small><strong>{person.data.name}</strong><span>↗</span></a>)}</div></section>}
  {entry.data.sources.length>0&&<section class="sources wrap"><p>Starting references</p>{entry.data.sources.map(source=><a href={source.url} target="_blank" rel="noreferrer">{source.label} ↗</a>)}</section>}<div class="next wrap"><a href="/history/">← Return to history</a><a href="/stories/">Read stories →</a></div></article>
</SiteLayout>
<style>.history-profile{padding-bottom:110px}.crumb{display:flex;gap:10px;padding:22px 0;font-size:9px;text-transform:uppercase;letter-spacing:.09em}.crumb span{color:#a9432e}.facts{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.facts>div{padding:25px;border-right:1px solid var(--line)}.facts>div:last-child{border:0}.facts small,.facts strong{display:block}.facts small,.body aside span{font-size:9px;text-transform:uppercase;letter-spacing:.11em;color:#a9432e}.facts strong{font:17px Georgia;margin-top:6px}.body{display:grid;grid-template-columns:200px minmax(0,700px);justify-content:center;gap:70px;padding-top:75px}.body aside p{font-size:12px;color:#69706b}.prose{font:20px/1.85 Georgia;color:#3e4b47}.prose :global(p:first-child){font-size:27px;color:#142c27}.connections,.sources{margin-top:70px;border-top:1px solid var(--line);padding-top:25px}.connections>div{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.connections a{background:#fff;padding:20px;display:grid;grid-template-columns:1fr auto}.connections small{grid-column:1/-1;text-transform:uppercase;font-size:8px;color:#a9432e}.connections strong{font:23px Georgia}.sources a{display:block;margin:10px 0;font-size:12px;text-decoration:underline}.next{margin-top:70px;background:#142c27;color:#f4eee2;padding:32px;display:flex;justify-content:space-between;font-size:9px;text-transform:uppercase;letter-spacing:.1em}@media(max-width:700px){.facts,.body{grid-template-columns:1fr}.facts>div{border-right:0;border-bottom:1px solid var(--line)}.body{gap:30px;padding-top:50px}.connections>div{grid-template-columns:1fr}.next{flex-direction:column;gap:18px}}</style>
