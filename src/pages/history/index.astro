---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
const entries = (await getCollection('history')).sort((a,b) => Number(b.data.featured)-Number(a.data.featured));
const periods = ['Ancient Bihar','Faith & learning','Kingdoms & powers','Colonial Bihar','Freedom movement','Modern Bihar'] as const;
---
<SiteLayout title="History" description="A growing history of Bihar, from ancient political worlds to modern movements." eyebrow="Bihar through time" heading="The past is still speaking." intro="Empires, republics, faith, learning, resistance and modern change—told as connected histories rather than a parade of dates.">
  <section class="timeline-intro"><div class="wrap"><p>History explains periods and events. Places hold their physical traces; People introduces the individuals within them; Stories asks new questions of both.</p><span>{entries.length} starting chapters</span></div></section>
  <nav class="period-nav wrap" aria-label="Historical periods">{periods.map((period,index)=><a href={`#period-${index+1}`}><span>0{index+1}</span>{period}</a>)}</nav>
  <section class="history-index wrap">{periods.map((period,index)=>{const periodEntries=entries.filter(entry=>entry.data.period===period);return <section class="period" id={`period-${index+1}`}><header><span>0{index+1}</span><h2>{period}</h2><p>{periodEntries.length} {periodEntries.length===1?'chapter':'chapters'}</p></header><div class="chapter-grid">{periodEntries.map(entry=><a class={`chapter accent-${entry.data.accent}`} href={`/history/${entry.id}/`}><small>{entry.data.dateLabel} · {entry.data.region}</small><h3>{entry.data.title}</h3><p>{entry.data.summary}</p><i>Read the chapter ↗</i></a>)}</div></section>})}</section>
  <section class="history-note"><div class="wrap"><p class="tag">How we tell history</p><blockquote>No golden age. No single decline. Context before nostalgia.</blockquote><p>Each chapter distinguishes evidence, interpretation and popular memory—and links outward instead of duplicating the same subject across the site.</p></div></section>
</SiteLayout>
<style>.timeline-intro{background:#142c27;color:#f4eee2;padding:52px 0}.timeline-intro>div{display:flex;justify-content:space-between;gap:60px;align-items:end}.timeline-intro p{font:22px/1.5 Georgia;max-width:760px;margin:0}.timeline-intro span{text-transform:uppercase;font-size:9px;letter-spacing:.12em;color:#e9a93a}.period-nav{display:grid;grid-template-columns:repeat(6,1fr);margin-top:40px;border:1px solid rgba(20,44,39,.16)}.period-nav a{padding:17px 13px;border-right:1px solid rgba(20,44,39,.16);font:15px Georgia}.period-nav a:last-child{border-right:0}.period-nav span{display:block;font:8px Arial;color:#a9432e;margin-bottom:7px}.history-index{padding:65px 0 120px}.period{padding:42px 0}.period>header{display:grid;grid-template-columns:45px 1fr auto;border-bottom:1px solid rgba(20,44,39,.2);align-items:end;padding-bottom:14px;margin-bottom:18px}.period>header span,.period>header p{font-size:9px;text-transform:uppercase;letter-spacing:.1em;color:#a9432e;margin:0}.period h2{font:35px Georgia;margin:0}.chapter-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}.chapter{background:#fff;border-top:5px solid var(--history-color);padding:28px;min-height:270px;display:flex;flex-direction:column}.chapter small{font-size:8px;text-transform:uppercase;letter-spacing:.1em;color:#a9432e}.chapter h3{font:34px/1.08 Georgia;margin:25px 0 10px}.chapter p{font-size:13px;color:#69706b}.chapter i{margin-top:auto;font-style:normal;font-size:9px;text-transform:uppercase;letter-spacing:.09em}.history-note{padding:95px 0;background:#e6d8c1}.history-note blockquote{font:clamp(38px,5vw,65px)/1.05 Georgia;max-width:850px;margin:15px 0 30px}.history-note>div>p:last-child{max-width:650px;color:#69706b}.accent-gold{--history-color:#b9892d}.accent-blue{--history-color:#66888a}.accent-red{--history-color:#a94e39}.accent-green{--history-color:#70876d}.accent-clay{--history-color:#b87550}.accent-indigo{--history-color:#475b72}@media(max-width:800px){.timeline-intro>div{display:grid}.period-nav{grid-template-columns:repeat(2,1fr)}.period-nav a{border-bottom:1px solid rgba(20,44,39,.16)}.chapter-grid{grid-template-columns:1fr}.history-index{padding-bottom:80px}.history-note{padding:75px 0}}</style>
