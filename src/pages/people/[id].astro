---
import {getCollection,render,type CollectionEntry} from 'astro:content'; import SiteLayout from '../../layouts/SiteLayout.astro';
export async function getStaticPaths(){const people=await getCollection('people');return people.map(person=>({params:{id:person.id},props:{person}}));}
interface Props{person:CollectionEntry<'people'>} const {person}=Astro.props; const {Content}=await render(person);
const culture=await getCollection('culture'); const history=await getCollection('history');
const relatedCulture=person.data.relatedCulture.map(id=>culture.find(item=>item.id===id)).filter(Boolean); const relatedHistory=person.data.relatedHistory.map(id=>history.find(item=>item.id===id)).filter(Boolean);
---
<SiteLayout title={person.data.name} description={person.data.summary} eyebrow={`${person.data.category} · ${person.data.years}`} heading={person.data.name} intro={person.data.summary} compactHero>
  <article class="profile"><div class="facts wrap"><div><small>Known for</small><strong>{person.data.knownFor}</strong></div><div><small>Life</small><strong>{person.data.years}</strong></div><div><small>Region</small><strong>{person.data.region}</strong></div></div><div class="body wrap"><aside><span>Editorial approach</span><p>Achievement belongs with context. This profile separates documented history from shorthand, legend and motivational retelling.</p></aside><div class="prose"><Content /></div></div>
  {(relatedCulture.length>0||relatedHistory.length>0)&&<section class="connections wrap"><p class="tag">Connected subjects</p><div>{relatedCulture.map(entry=>entry&&<a href={`/culture/${entry.data.section}/${entry.id}/`}><small>Culture</small><strong>{entry.data.title}</strong><span>↗</span></a>)}{relatedHistory.map(entry=>entry&&<a href={`/history/${entry.id}/`}><small>History</small><strong>{entry.data.title}</strong><span>↗</span></a>)}</div></section>}
  <div class="next wrap"><a href="/people/">← All people</a><a href="/stories/">Read stories →</a></div></article>
</SiteLayout>
<style>.profile{padding-bottom:110px}.facts{display:grid;grid-template-columns:repeat(3,1fr);border-bottom:1px solid var(--line)}.facts>div{padding:27px;border-right:1px solid var(--line)}.facts>div:last-child{border:0}.facts small,.facts strong{display:block}.facts small,.body aside span{font-size:9px;text-transform:uppercase;letter-spacing:.1em;color:#a9432e}.facts strong{font:17px Georgia;margin-top:6px}.body{display:grid;grid-template-columns:200px minmax(0,700px);justify-content:center;gap:70px;padding-top:75px}.body aside p{font-size:12px;color:#69706b}.prose{font:20px/1.85 Georgia;color:#3e4b47}.prose :global(p:first-child){font-size:27px;color:#142c27}.connections{margin-top:70px;border-top:1px solid var(--line);padding-top:25px}.connections>div{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.connections a{background:#fff;padding:20px;display:grid;grid-template-columns:1fr auto}.connections small{grid-column:1/-1;text-transform:uppercase;font-size:8px;color:#a9432e}.connections strong{font:23px Georgia}.next{margin-top:70px;background:#142c27;color:#f4eee2;padding:32px;display:flex;justify-content:space-between;font-size:9px;text-transform:uppercase;letter-spacing:.1em}@media(max-width:700px){.facts,.body{grid-template-columns:1fr}.facts>div{border-right:0;border-bottom:1px solid var(--line)}.body{gap:30px;padding-top:50px}.connections>div{grid-template-columns:1fr}.next{flex-direction:column;gap:18px}}</style>
