---
import { getCollection } from 'astro:content'; import SiteLayout from '../../layouts/SiteLayout.astro';
const people=(await getCollection('people')).sort((a,b)=>Number(b.data.featured)-Number(a.data.featured)||a.data.name.localeCompare(b.data.name));
const categories=['Historical figures','Artists & writers','Scientists & scholars','Sport & public life','Entrepreneurs & builders','Community custodians'] as const;
---
<SiteLayout title="People" description="Meet people from Bihar who shaped knowledge, art, public life, enterprise and community memory." eyebrow="Made in Bihar" heading="Lives that changed the possible." intro="Celebrated figures and living traditions both have names. This archive centres achievement, contradiction, context and the work behind public memory.">
  <section class="people-intro"><div class="wrap"><p>Not a hall of fame. A growing archive of lives understood in their time, place and field.</p><strong>{people.length}<span>starting profiles</span></strong></div></section>
  <section class="people-index wrap">{categories.map((category,index)=>{const entries=people.filter(person=>person.data.category===category);return <section class="category"><header><span>0{index+1}</span><h2>{category}</h2><p>{entries.length} {entries.length===1?'profile':'profiles'}</p></header><div class="people-grid">{entries.map(person=><a class={`person accent-${person.data.accent}`} href={`/people/${person.id}/`}><div><span>{person.data.name.split(' ').map(part=>part[0]).slice(0,2).join('')}</span></div><small>{person.data.years} · {person.data.region}</small><h3>{person.data.name}</h3><b>{person.data.knownFor}</b><p>{person.data.summary}</p><i>Read profile ↗</i></a>)}</div></section>})}</section>
</SiteLayout>
<style>.people-intro{background:#142c27;color:#f4eee2;padding:52px 0}.people-intro>div{display:flex;justify-content:space-between;gap:50px;align-items:center}.people-intro p{font:23px Georgia;margin:0;max-width:700px}.people-intro strong{font:48px Georgia;color:#e9a93a;display:flex;align-items:center;gap:12px}.people-intro strong span{font:9px Arial;text-transform:uppercase;letter-spacing:.1em;color:#f4eee2}.people-index{padding:65px 0 120px}.category{padding:42px 0}.category>header{display:grid;grid-template-columns:45px 1fr auto;align-items:end;border-bottom:1px solid var(--line);padding-bottom:14px;margin-bottom:18px}.category>header span,.category>header p{font-size:9px;text-transform:uppercase;letter-spacing:.1em;color:#a9432e;margin:0}.category h2{font:35px Georgia;margin:0}.people-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.person{background:#fff;border-top:5px solid var(--people-color);padding:22px}.person>div{width:65px;height:65px;border-radius:50%;display:grid;place-items:center;background:var(--people-color);color:#fff;font:22px Georgia}.person small{display:block;margin-top:22px;font-size:8px;text-transform:uppercase;color:#a9432e}.person h3{font:29px/1.08 Georgia;margin:5px 0}.person b{font-size:10px;text-transform:uppercase;letter-spacing:.08em}.person p{font-size:12px;color:#69706b;min-height:78px}.person i{font-style:normal;font-size:8px;text-transform:uppercase;letter-spacing:.09em}.accent-gold{--people-color:#b9892d}.accent-blue{--people-color:#66888a}.accent-red{--people-color:#a94e39}.accent-green{--people-color:#70876d}.accent-clay{--people-color:#b87550}.accent-indigo{--people-color:#475b72}@media(max-width:900px){.people-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:600px){.people-intro>div{display:grid}.people-grid{grid-template-columns:1fr}.people-index{padding-bottom:80px}.person p{min-height:0}}</style>
