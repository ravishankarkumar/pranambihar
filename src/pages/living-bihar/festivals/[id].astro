---
import { getEntry, type CollectionEntry } from 'astro:content';
import CultureEntryPage from '../../../components/CultureEntryPage.astro';
export async function getStaticPaths() {
  const ids = ['bol-bam', 'chhath', 'dussehra-to-chhath', 'garibnath-shravan', 'holi', 'sama-chakeva'];
  return Promise.all(ids.map(async (id) => {
    const entry = await getEntry('culture', id);
    if (!entry) throw new Error(`Missing culture entry: ${id}`);
    return { params: { id }, props: { entry } };
  }));
}
interface Props { entry: CollectionEntry<'culture'>; }
const { entry } = Astro.props;
---
<CultureEntryPage entry={entry} sectionName="Festivals" />
