---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';

const entries = await getCollection('culture');
const sectionData = [
  ['festivals','Festivals','The year in motion','Ritual calendars, preparation, public space and the work behind celebration.','उत्सव'],
  ['languages','Languages','Many voices, full worlds','Five languages in focus and the regional voices that widen Bihar’s linguistic story.','भाषा'],
  ['art-craft','Art & Craft','Made by hand and imagination','Painting, grass, line and material—always with the maker visible.','कला'],
  ['textiles','Textiles','Cloth, stitch and loom','Silk, cotton, embroidery, appliqué and painted cloth shaped by makers and place.','वस्त्र'],
  ['music-performance','Music & Performance','Culture in voice and movement','Theatre, dance, song and performance traditions shaped by occasion and audience.','सुर'],
  ['traditions','Traditions','Knowledge in practice','Ritual, household knowledge and ways of doing passed between people.','रीति'],
  ['living-memory','Living Memory','The present becoming history','What Bihar remembers, what is changing and what people continue to carry.','स्मृति'],
] as const;
const featuredIds = ['chhath','bhojpuri','madhubani-painting','bhagalpur-silk','bidesia','bhuiya-baba-puja','sonpur-fair'];
const featured = featuredIds.map(id => entries.find(entry => entry.id === id)).filter(Boolean);
const sectionCount = (section: string) => entries.filter(entry => entry.data.section === section).length;
---

<SiteLayout title="Culture" description="Festivals, languages, art, performance, traditions and changing memory across Bihar." eyebrow="Living Bihar" heading="Culture is something people do." intro="Bihar lives through voice, line, rhythm, ritual and memory. This is an atlas of cultural practice—and of the people who keep remaking it.">
  <section class="culture-statement"><div class="wrap"><blockquote>Culture is not a cabinet of old things. It changes each time a song is sung, a language is spoken or a hand begins its work.</blockquote><a href="/people/">Meet the people who carry it →</a></div></section>

  <nav class="section-grid wrap" aria-label="Culture sections">
    {sectionData.map(([id,title,kicker,summary,mark],index) => <a class={`section-card accent-${['red','blue','gold','clay','green','indigo','red'][index]}`} href={`/culture/${id}/`}><span>0{index+1}</span><b>{mark}</b><small>{kicker}</small><h2>{title}</h2><p>{summary}</p><i>{sectionCount(id)} entries ↗</i></a>)}
  </nav>

  <section class="culture-sampler"><div class="wrap"><div class="heading"><div><p class="tag">Across the atlas</p><h2>Seven doors into<br/><em>living Bihar.</em></h2></div><p>Begin anywhere. Each subject has one home, then connects outward to its people, places, foods and history.</p></div><div class="sample-list">{featured.map((entry,index) => entry && <a href={`/culture/${entry.data.section}/${entry.id}/`}><span>{String(index+1).padStart(2,'0')}</span><div><small>{entry.data.kind}</small><h3>{entry.data.title}</h3></div><p>{entry.data.summary}</p><i>↗</i></a>)}</div></div></section>

  <section class="people-bridge"><div class="wrap"><p class="tag">Names, not anonymity</p><h2>The tradition is shared.<br/><em>The story is personal.</em></h2><p>Artists, performers, speakers, organisers and custodians belong in the People archive as individuals—not as anonymous representatives of culture.</p><a href="/people/">Explore People →</a></div></section>
</SiteLayout>

<style>
  .culture-statement{padding:72px 0;background:#142c27;color:#f4eee2}.culture-statement>div{display:grid;grid-template-columns:1.4fr .6fr;gap:80px;align-items:end}.culture-statement blockquote{font:clamp(27px,3.4vw,43px)/1.25 Georgia;margin:0}.culture-statement a,.people-bridge a{font-size:9px;text-transform:uppercase;letter-spacing:.1em;border-bottom:1px solid;justify-self:start}.section-grid{display:grid;grid-template-columns:repeat(12,1fr);gap:16px;padding-top:90px;padding-bottom:115px}.section-card{grid-column:span 4;background:#fff;border-top:6px solid var(--culture-color);padding:27px;min-height:330px;display:grid;grid-template-columns:1fr auto;align-content:start}.section-card:nth-child(n+4){grid-column:span 3}.section-card>span{font-size:9px;color:#a9432e}.section-card>b{grid-row:1/3;grid-column:2;width:58px;height:58px;border-radius:50%;display:grid;place-items:center;background:var(--culture-color);color:#fff;font:20px Georgia}.section-card small{font-size:8px;text-transform:uppercase;letter-spacing:.09em;color:#a9432e;margin-top:28px}.section-card h2{grid-column:1/-1;font:32px Georgia;margin:5px 0 12px}.section-card p{grid-column:1/-1;font-size:12px;color:#69706b}.section-card i{grid-column:1/-1;align-self:end;border-top:1px solid rgba(20,44,39,.14);padding-top:15px;font-style:normal;font-size:8px;text-transform:uppercase;letter-spacing:.09em}.culture-sampler{padding:105px 0;background:#e6d8c1}.heading{display:grid;grid-template-columns:1fr 390px;gap:60px;align-items:end;margin-bottom:45px}.heading h2,.people-bridge h2{font:clamp(46px,5.5vw,76px)/.98 Georgia;margin:14px 0 0}.heading h2 em,.people-bridge h2 em{font-weight:normal;color:#e0a33c}.heading>p{color:#69706b}.sample-list{display:grid}.sample-list a{display:grid;grid-template-columns:45px .8fr 1.2fr 20px;gap:28px;align-items:center;padding:24px 0;border-top:1px solid rgba(20,44,39,.18)}.sample-list a:last-child{border-bottom:1px solid rgba(20,44,39,.18)}.sample-list>a>span,.sample-list small{font-size:8px;text-transform:uppercase;letter-spacing:.08em;color:#a9432e}.sample-list h3{font:28px Georgia;margin:3px 0}.sample-list p{font-size:12px;color:#69706b;margin:0}.sample-list i{font-style:normal}.people-bridge{padding:105px 0;background:#a9432e;color:#f4eee2}.people-bridge>div{max-width:900px}.people-bridge h2 em{color:#f2bd5c}.people-bridge>div>p:not(.tag){max-width:650px;color:rgba(255,255,255,.72)}.accent-gold{--culture-color:#b9892d}.accent-blue{--culture-color:#66888a}.accent-red{--culture-color:#a94e39}.accent-green{--culture-color:#70876d}.accent-clay{--culture-color:#b87550}.accent-indigo{--culture-color:#475b72}
  @media(max-width:800px){.culture-statement>div,.heading{grid-template-columns:1fr;gap:30px}.section-grid{grid-template-columns:repeat(2,minmax(0,1fr));padding:70px 24px 85px}.section-card,.section-card:nth-child(n+4){grid-column:auto}.sample-list a{grid-template-columns:35px 1fr 20px}.sample-list p{grid-column:2}.culture-sampler,.people-bridge{padding:75px 0}}@media(max-width:520px){.section-grid{grid-template-columns:1fr}.section-card{min-height:290px}}
</style>
